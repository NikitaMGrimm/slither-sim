{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SlitherSim capture attempt ledger event v1",
  "type": "object",
  "required": ["schemaVersion", "event", "attemptId", "studyId", "planSha256", "time"],
  "properties": {
    "schemaVersion": {"const": 1},
    "event": {"enum": ["started", "finished"]},
    "attemptId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"},
    "studyId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "planSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "time": {"type": "string", "format": "date-time"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"enum": ["completed", "failed", "interrupted"]},
    "exitCode": {"type": ["integer", "null"]},
    "captures": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "error": {"type": ["string", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"event": {"const": "started"}}}, "then": {"required": ["command"]}},
    {"if": {"properties": {"event": {"const": "finished"}}}, "then": {"required": ["status", "exitCode", "captures"]}}
  ],
  "additionalProperties": false
}
