{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SlitherSim evidence bundle manifest v1",
  "type": "object",
  "required": ["schemaVersion", "studyId", "planSha256", "dataOrigin", "scientificStatus", "createdAt", "audit", "files"],
  "properties": {
    "schemaVersion": {"const": 1},
    "studyId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "planSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dataOrigin": {"enum": ["official-server", "community-server", "local-simulator"]},
    "scientificStatus": {"const": "unreviewed"},
    "createdAt": {"type": "string", "format": "date-time"},
    "audit": {
      "type": "object", "required": ["status", "issues", "attempts", "captures"],
      "properties": {
        "status": {"enum": ["verified", "incomplete", "quarantined"]},
        "issues": {"type": "array", "items": {"type": "string"}},
        "attempts": {"type": "integer", "minimum": 0},
        "captures": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array", "minItems": 4,
      "items": {
        "type": "object", "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
