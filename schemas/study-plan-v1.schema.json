{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NikitaMGrimm/slither-sim/schemas/study-plan-v1.schema.json",
  "title": "SlitherSim evidence study plan v1",
  "type": "object",
  "required": ["schemaVersion", "studyId", "title", "kind", "dataOrigin", "question", "hypotheses", "method", "sampling", "exclusions", "validation", "limitations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "studyId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "title": {"type": "string", "minLength": 1},
    "kind": {"enum": ["exploratory", "confirmatory", "pipeline-test"]},
    "dataOrigin": {"enum": ["official-server", "community-server", "local-simulator"]},
    "question": {"type": "string", "minLength": 1},
    "hypotheses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "method": {"type": "string", "minLength": 1},
    "sampling": {
      "type": "object",
      "required": ["unit", "attempts", "selection", "independence"],
      "properties": {
        "unit": {"type": "string", "minLength": 1},
        "attempts": {"type": "integer", "minimum": 1, "maximum": 1000},
        "selection": {"type": "string", "minLength": 1},
        "independence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "exclusions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "validation": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "capture": {
      "type": "object",
      "required": ["server", "scenario", "seconds", "bots"],
      "properties": {
        "server": {
          "type": "object", "required": ["ip", "port"],
          "properties": {"ip": {"type": "string", "minLength": 1}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}},
          "additionalProperties": false
        },
        "origin": {"type": "string", "pattern": "^https?://[^/?#\\s]+$"},
        "scenario": {"enum": ["forage", "boost", "ownpellets", "spawn", "movement", "preyprobe", "boundaryprobe", "visibilityprobe", "speedprobe", "paired-prey", "paired-snake", "food-lanes"]},
        "seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600},
        "bots": {"type": "integer", "minimum": 1, "maximum": 3},
        "mode": {"enum": ["overlap", "crossing"]},
        "direction": {"enum": ["x", "y", "diagonal-positive", "diagonal-negative"]}
      },
      "allOf": [
        {
          "if": {"properties": {"scenario": {"enum": ["paired-prey", "paired-snake"]}}},
          "then": {
            "required": ["mode"],
            "properties": {"bots": {"const": 2}, "seconds": {"minimum": 1, "maximum": 3600}}
          },
          "else": {"not": {"anyOf": [{"required": ["mode"]}, {"required": ["direction"]}]}}
        },
        {
          "if": {"required": ["direction"]},
          "then": {"required": ["mode"], "properties": {"mode": {"const": "crossing"}}}
        },
        {
          "if": {"properties": {"scenario": {"const": "food-lanes"}}},
          "then": {"properties": {"bots": {"const": 1}, "seconds": {"minimum": 1, "maximum": 480}}}
        },
        {
          "if": {"properties": {"scenario": {"const": "paired-snake"}}},
          "then": {"required": ["direction"], "properties": {"mode": {"const": "crossing"}}}
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
