+// One coverage mask, at most 512*512 bytes under materialize's extent limit.
+// Authored body palettes share the same circle while their color samples differ.
+// Cache only the exact 4x4 sample counts; painting and rounding remain unchanged.
+// Study: research/client-performance/2026-11-02-cold-sprite-masks/REPORT.md.
+#[derive(Default)]
+pub(crate) struct CircleCoverageCache {
+    key: Option<([usize; 2], [u64; 5])>,
+    counts: Vec<u8>,
+}
+impl CircleCoverageCache {
+    fn get(&mut self, w: usize, h: usize, circle: [f64; 5]) -> &[u8] {
+        let key = ([w, h], circle.map(f64::to_bits));
+        if self.key != Some(key) {
+            self.counts.clear();
+            self.counts.reserve_exact(w * h);
+            for y in 0..h {
+                for x in 0..w {
+                    let mut n = 0;
+                    for sy in 0..4 {
+                        for sx in 0..4 {
+                            let px = x as f64 + (sx as f64 + 0.5) / 4.;
+                            let py = y as f64 + (sy as f64 + 0.5) / 4.;
+                            n += u8::from((px - circle[0]).hypot(py - circle[1]) <= circle[2]);
+                        }
+                    }
+                    self.counts.push(n);
+                }
+            }
+            self.key = Some(key);
+        }
+        &self.counts
+    }
+}
+
+pub(crate) fn materialize_cached(
+    recipe: &CanvasRecipe,
+    cache: &mut CircleCoverageCache,
+) -> Result<RgbaImage> {
+    materialize_impl(recipe, Some(cache))
+}
