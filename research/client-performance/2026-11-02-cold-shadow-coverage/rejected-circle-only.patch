+#[cfg(test)]
+mod circle_coverage_tests {
+    use super::*;
+    fn recipe(width: u32, height: u32, commands: Vec<PaintCommand>) -> CanvasRecipe {
+        CanvasRecipe {
+            width,
+            height,
+            half_width: f64::from(width) / 2.,
+            half_height: f64::from(height) / 2.,
+            commands,
+        }
+    }
+
+    #[test]
+    fn cached_circle_samples_preserve_authored_pixels_and_geometry_changes() {
+        let mut cache = CircleCoverageCache::default();
+        let mut cases = Vec::new();
+        for (w, h, circle) in [
+            (8, 8, [4., 4., 2., 0., std::f64::consts::TAU]),
+            (8, 8, [4., 4., 3., 0., std::f64::consts::TAU]),
+            (8, 8, [4.125, 3.75, 3., 0., std::f64::consts::TAU]),
+            (9, 8, [4., 4., 3., 0., std::f64::consts::TAU]),
+            (8, 9, [-0., 0., 2., 0., std::f64::consts::TAU]),
+            (8, 9, [0., -0., 2., 0., std::f64::consts::TAU]),
+            (8, 9, [1e100, -1e100, 1e100, 0., std::f64::consts::TAU]),
+        ] {
+            for color in ["#ff0000", "rgba(20,80,150,0.3)"] {
+                cases.push(recipe(
+                    w,
+                    h,
+                    vec![
+                        PaintCommand::FillStyle(color.into()),
+                        PaintCommand::BeginPath,
+                        PaintCommand::Arc(circle),
+                        PaintCommand::Fill,
+                    ],
+                ));
+            }
+        }
+        // Real authored palette/decoration tapes share the mask, not their paint.
+        for palette in slither_client::authored_sources::authored_source_recipes()
+            .body_sources
+            .palettes
+        {
+            cases.push(palette.variants.first().unwrap().clone());
+            cases.push(palette.variants.last().unwrap().clone());
+        }
+        let mut shadow = recipe(
+            8,
+            8,
+            vec![
+                PaintCommand::Shadow {
+                    blur: 2.,
+                    offset_y: 0.5,
+                    color: "#000000".into(),
+                },
+                PaintCommand::BeginPath,
+                PaintCommand::Arc([4., 4., 2., 0., std::f64::consts::TAU]),
+                PaintCommand::Fill,
+            ],
+        );
+        cases.push(shadow.clone());
+        shadow
+            .commands
+            .push(PaintCommand::Composite("destination-in"));
+        shadow.commands.push(PaintCommand::Fill);
+        cases.push(shadow); // An unsupported shadow operation must keep its error.
+        cases.push(recipe(
+            8,
+            8,
+            vec![
+                PaintCommand::FillStyle("#ffffff".into()),
+                PaintCommand::FillRect([0., 0., 8., 8.]),
+            ],
+        ));
+        for recipe in cases {
+            let expected = materialize(&recipe);
+            let actual = materialize_cached(&recipe, &mut cache);
+            match (actual, expected) {
+                (Ok(a), Ok(b)) => {
+                    assert_eq!((a.width, a.height), (b.width, b.height));
+                    assert_eq!(a.pixels, b.pixels);
+                }
+                (Err(a), Err(b)) => assert_eq!(a, b),
+                other => panic!("cached raster mismatch: {other:?}"),
+            }
+            assert!(cache.counts.len() <= 512 * 512);
+            assert!(cache.counts.capacity() <= 512 * 512);
+        }
+    }
+}
