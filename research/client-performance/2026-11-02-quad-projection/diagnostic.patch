+use slither_wgpu_slice::{Result, endpoint_login, game::{LocalGame,EffectKind}, native::{Transport,Event}, gpu, latency, render};
+use std::{alloc::{GlobalAlloc,Layout,System},cell::{Cell,RefCell},time::{Instant,Duration},path::PathBuf,io::Write,hash::{Hash,Hasher}};
+struct Counting;
+thread_local! { static GPU_SAMPLES: RefCell<Vec<(u64,usize,&'static str,u64)>> = const {RefCell::new(Vec::new())}; static CURRENT_FRAME: Cell<usize> = const {Cell::new(0)}; static ALLOC: Cell<(u64,u64)> = const {Cell::new((0,0))}; static PHASES: RefCell<Vec<(&'static str,u64,u64)>> = const {RefCell::new(Vec::new())}; }
+unsafe impl GlobalAlloc for Counting {
+ unsafe fn alloc(&self,l:Layout)->*mut u8 {ALLOC.with(|s|{let (n,b)=s.get();s.set((n+1,b+l.size() as u64));});unsafe{System.alloc(l)}}
+ unsafe fn dealloc(&self,p:*mut u8,l:Layout){unsafe{System.dealloc(p,l)}}
+ unsafe fn alloc_zeroed(&self,l:Layout)->*mut u8 {ALLOC.with(|s|{let(n,b)=s.get();s.set((n+1,b+l.size() as u64));});unsafe{System.alloc_zeroed(l)}}
+ unsafe fn realloc(&self,p:*mut u8,l:Layout,n:usize)->*mut u8 {ALLOC.with(|s|{let(a,b)=s.get();s.set((a+1,b+n as u64));});unsafe{System.realloc(p,l,n)}}
+}
+#[global_allocator] static COUNTING:Counting=Counting;
+static EPOCH:std::sync::OnceLock<Instant>=std::sync::OnceLock::new();
+fn phase(s:&'static str,id:u64){PHASES.with_borrow_mut(|p| p.push((s,EPOCH.get_or_init(Instant::now).elapsed().as_nanos() as u64,id)));}
+fn ns(t:Instant)->u64 {t.elapsed().as_nanos() as u64}
+fn effects(g:&mut LocalGame,t:&mut Transport,live:bool,now:f64,hash:&mut impl Hasher)->Result<()> {
+ for _ in 0..256 {let Some(e)=g.effect() else {return Ok(())};let connect=matches!(e.kind,EffectKind::Connect(_));
+  if connect {g.construct(e.generation,e.id,now)?;}
+  if live {t.execute(&e)?;}
+  if let EffectKind::Send(b)=&e.kind {b.hash(hash);}
+  g.acknowledge(e.generation,e.id,true)?;
+  if connect && !live {g.opened(e.generation,now)?;}
+ } Err("effect budget".into())
+}
+struct Gpu {presenter:slither_wgpu_slice::world_presenter::WorldPresenter,r:gpu::Renderer,_target:wgpu::Texture,view:wgpu::TextureView}
+impl Gpu {
+ fn new()->Result<Self>{let i=gpu::instance();let adapters=pollster::block_on(i.enumerate_adapters(wgpu::Backends::DX12));let a=adapters.into_iter().find(|a|a.get_info().device_type==wgpu::DeviceType::IntegratedGpu).ok_or("integrated adapter missing")?;
+ let r=pollster::block_on(gpu::Renderer::from_adapter_for_diagnostics(a,wgpu::TextureFormat::Rgba8Unorm,4,true))?;println!("adapter={:?},samples={}",r.adapter_info,r.sample_count);
+ let target=r.device.create_texture(&wgpu::TextureDescriptor{label:Some("capture profile"),size:wgpu::Extent3d{width:960,height:540,depth_or_array_layers:1},mip_level_count:1,sample_count:1,dimension:wgpu::TextureDimension::D2,format:wgpu::TextureFormat::Rgba8Unorm,usage:wgpu::TextureUsages::RENDER_ATTACHMENT,view_formats:&[]});let view=target.create_view(&Default::default());let presenter=slither_wgpu_slice::world_presenter::WorldPresenter::new(&r);Ok(Self{presenter,r,_target:target,view})}
+ fn draw(&mut self,p:&render::PreparedFrame)->Result<(u64,u64,u64,f64)>{let t=Instant::now();self.r.sync_resources(&p.resources).map_err(String::from)?;let sync=ns(t);let t=Instant::now();self.r.begin_diagnostic_frame();self.presenter.render(&mut self.r,&p.frame,p.overlay.as_ref(),&self.view,[960,540],slither_client::settings::WorldResolution::Original).map_err(String::from)?;let submit=ns(t);
