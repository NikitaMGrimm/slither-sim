+fn capture(gpu: &Gpu, path: &std::path::Path) -> Result<()> {
+    let r = &gpu.r;
+    let b = r.device.create_buffer(&wgpu::BufferDescriptor {
+        label: None,
+        size: 960 * 540 * 4,
+        usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+        mapped_at_creation: false,
+    });
+    let mut e = r.device.create_command_encoder(&Default::default());
+    e.copy_texture_to_buffer(
+        wgpu::TexelCopyTextureInfo {
+            texture: &gpu._target,
+            mip_level: 0,
+            origin: wgpu::Origin3d::ZERO,
+            aspect: wgpu::TextureAspect::All,
+        },
+        wgpu::TexelCopyBufferInfo {
+            buffer: &b,
+            layout: wgpu::TexelCopyBufferLayout {
+                offset: 0,
+                bytes_per_row: Some(3840),
+                rows_per_image: Some(540),
+            },
+        },
+        gpu._target.size(),
+    );
+    r.queue.submit([e.finish()]);
+    let (tx, rx) = std::sync::mpsc::channel();
+    b.slice(..).map_async(wgpu::MapMode::Read, move |v| {
+        let _ = tx.send(v);
+    });
+    r.device
+        .poll(wgpu::PollType::Wait {
+            submission_index: None,
+            timeout: Some(Duration::from_secs(10)),
+        })
+        .map_err(|e| e.to_string())?;
+    rx.recv().unwrap().map_err(|e| e.to_string())?;
+    std::fs::write(
+        path,
+        &b.slice(..).get_mapped_range().map_err(|e| e.to_string())?,
+    )
+    .map_err(|e| e.to_string())?;
+    Ok(())
+}
