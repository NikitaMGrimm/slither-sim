+r=Path(__file__).resolve().parent;s=r/'socket';root=s/'runs/mature'
+meta=json.loads((root/'summary.json').read_text());assert meta['status']=='complete'
+assert [x['cacheEnabled'] for x in meta['holds']]==[False,True,True,False]
+fine=s/'runs/fine';fine.mkdir()
+for name in ['host.log','client.log','telemetry.jsonl']:(fine/name).symlink_to(root/name)
+detail=json.loads((root/'summary.json').read_text())
+detail['holds']=[{'startUnix':meta['diagnosticStartUnix']+1.0,'endUnix':meta['diagnosticEndUnix']-1.0,'cacheEnabled':True,'fine':True}];detail['holdCount']=1
+(fine/'summary.json').write_text(json.dumps(detail,indent=2)+'\n')
+subprocess.run(['python3',str(s/'select.py'),str(s),str(s/'accepted.json'),'mature','fine'],check=True)
+accepted=json.loads((s/'accepted.json').read_text())
+def q(v,p):return sorted(v)[math.ceil((len(v)-1)*p)]
+def due(t):return math.floor(t*.007/.504)>math.floor((t-1)*.007/.504)
+def summary(rows):
+ return {'ticks':len(rows),'worldCpuMsMean':statistics.mean(x[1]+x[2] for x in rows)/1e6,'worldCpuMsP99':q([(x[1]+x[2])/1e6 for x in rows],.99),'simulationCpuMsMean':statistics.mean(x[1] for x in rows)/1e6,'socketCpuMsMean':statistics.mean(x[2] for x in rows)/1e6}
+census={};blocks={}
+for line in (root/'host.log').read_text().splitlines():
+ if line.startswith('CENSUS '):v=json.loads(line[7:]);census[v['tick']]=v
+ elif line.startswith('CAPACITY '):v=json.loads(line[9:]);blocks[v['tick']]=v
+result={'machine':'a 4-vCPU Zen 5 EPYC KVM guest','limits':'Four sequential holds in one mature evolving world and one research binary; not fixed trajectories or separate production binaries. Fine diagnostics follow separately. Loopback socket CPU includes receiver processing.','windows':[]}
+for name,m in [('mature',meta),('fine',detail)]:
+ for index,h in enumerate(m['holds']):
+  ticks=sorted(t for t in blocks if t-100 in census and census[t-100]['unix']>=h['startUnix'] and census[t]['unix']<=h['endUnix'])
+  rows=[[t-99+i,*x[:2]] for t in ticks for i,x in enumerate(blocks[t]['rows'])]
+  a=accepted['cases'][name]['holds'][index]
+  assert summary(rows)['ticks']==a['ticks'] and summary(rows)['worldCpuMsP99']==a['worldCpuMsPerTick']['p99']
+  window={'cacheEnabled':h['cacheEnabled'],'fine':name=='fine','tickRange':[rows[0][0],rows[-1][0]],'all':summary(rows),'maintenance':summary([x for x in rows if due(x[0])]),'ordinary':summary([x for x in rows if not due(x[0])]),'census':a['census'],'client':{'keepsUp':a['client']['keepsUp'],'workerCpuFractionMaxP99':max(v['p99'] for v in a['client']['workersCpuFraction'].values()),'worstOneSecondLateP99Ms':a['client']['worstOneSecondLateP99Ms'],'cpuCoresMean':a['client']['processCpuCoresMean'],'counterDeltas':a['client']['counterDeltas']},'socket':{'backpressure':a['socket']['backpressure'],'playersRange':a['socket']['playersRange'],'queueBytesMax':a['socket']['queues']['queueBytes']['max'],'kernelQueueBytesMax':a['socket']['queues']['kernelSendBytes']['max'],'kernelQueueSlopeBytesPerSecond':a['socket']['queues']['kernelSendBytes']['slopeBytesPerSecond']},'cpuReconciliationMsPerTick':a['cpuReconciliationMsPerTick'],'backgroundScreen':a['backgroundProcessScreen'],'deferredTicks':a['deferredTicks']}
+  result['windows'].append(window)
+  if name=='fine':
+   fine_rows=[v for t in ticks for v in blocks[t]['detail']];assert len(fine_rows)==len(rows)
+   labels=['subscriptionAndProcessing','recipientFood','preparation','snakeVisibilityEncoding']
+   def phases(xs):
+    return {'ticks':len(xs),'cpuMsMean':{label:statistics.mean(v[i+3] for v in xs)/1e6 for i,label in enumerate(labels)},'socketCpuMsMean':statistics.mean(v[2] for v in xs)/1e6,'perRecipientMean':{label:statistics.mean(v[i+7] for v in xs)/500 for i,label in enumerate(['webSocketMessages','tcpWriteCalls','openFlushCalls'])}}
+   result['fine']={label:phases(xs) for label,xs in [('all',fine_rows),('maintenance',[v for v in fine_rows if due(v[0])]),('ordinary',[v for v in fine_rows if not due(v[0])]),('topOnePercent',sorted(fine_rows,key=lambda v:v[1]+v[2],reverse=True)[:math.ceil(len(fine_rows)*.01)])]}
+result['pins']={'host':hashlib.file_digest((s/'live/bin/host').open('rb'),'sha256').hexdigest(),'client':accepted['commonClient']['binarySha256'],'runtimeCommit':json.loads((s/'live/pins.json').read_text())['commit'],'rustSourcesDigest':hashlib.sha256(json.dumps(json.loads((s/'live/pins.json').read_text())['overlays'],sort_keys=True).encode()).hexdigest()}
+result['cpuSeconds']={'hostClient':meta['waitedHostClientCpuSeconds'],'controller':meta['controllerCpuSeconds']}
+assert sum(result['cpuSeconds'].values())<3600
+(r/'live-selected.json').write_text(json.dumps(result,indent=2)+'\n')
+for v in result['windows']:print('LIVE',v['cacheEnabled'],v['fine'],v['all'],v['maintenance'],flush=True)
+print('FINE',json.dumps(result['fine'],indent=2),flush=True)
