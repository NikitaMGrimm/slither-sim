+def replace(a,b):
+ global s
+ assert s.count(a)==1,(a,s.count(a));s=s.replace(a,b)
+replace('hold_count=1 if smoke or short_mature else 3','hold_count=1 if smoke else 4')
+replace('hold_seconds=20 if smoke else (30 if short_mature else 300)','hold_seconds=15')
+replace('diagnostic_seconds=5 if smoke else (15 if short_mature else 60)','diagnostic_seconds=15')
+replace("CAPACITY_DIAGNOSTIC=str(root/'DIAGNOSTIC')", "CAPACITY_DIAGNOSTIC=str(root/'DIAGNOSTIC'),CAPACITY_CACHE=str(root/'CACHE'),CAPACITY_FINE=str(root/'FINE')")
+replace("(root/'DIAGNOSTIC').touch();profile=now+diagnostic_seconds;", "(root/'DIAGNOSTIC').touch();(root/'FINE').touch();profile=now+diagnostic_seconds;")
+replace("telemetry.write(json.dumps({'server':ss,'client':cs})+'\\n');telemetry.flush();last_sample=now", """telemetry.write(json.dumps({'server':ss,'client':cs})+'\\n');telemetry.flush();last_sample=now
+    used=sum(v['process']['user']+v['process']['system'] for v in [ss,cs])+time.process_time()
+    assert used<3600,'host+client+controller CPU budget exhausted'
+    meta['cpuSecondsUsed']=used;save()""")
