+        def phases(xs):return {'ticks':len(xs),'cpuMsMean':{label:statistics.mean(v[i+3] for v in xs)/1e6 for i,label in enumerate(['subscriptionAndProcessing','recipientFood','preparation','snakeVisibilityEncoding'])},'socketCpuMsMean':statistics.mean(v[2] for v in xs)/1e6,'perRecipientMean':{label:statistics.mean(v[i+7] for v in xs)/500 for i,label in enumerate(['webSocketMessages','tcpWriteCalls','openFlushCalls'])}}
