+++ b/run_fixed.py
@@ -0,0 +1,44 @@
+"""Forward the retained comparer output; sample existing logs only during warmup."""
+from pathlib import Path
+import argparse,json,os,subprocess,sys,time,threading
+r=Path(__file__).resolve().parent
+parser=argparse.ArgumentParser()
+parser.add_argument('case')
+parser.add_argument('--warm',type=int,default=193000)
+parser.add_argument('--ticks',type=int,default=360)
+a=parser.parse_args()
+os.sched_setaffinity(0,{2})
+command=['python3',str(r/'serve.py'),a.case,'base','candidate','--legacy',str(int(a.case=='legacy')),'--warm',str(a.warm),'--ticks',str(a.ticks)]
+with (r/(a.case+'.stream.log')).open('xb') as log:
+    proc=subprocess.Popen(command,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
+    def forward():
+        for line in proc.stdout:
+            log.write(line)
+            log.flush()
+            sys.stdout.buffer.write(line)
+            sys.stdout.buffer.flush()
+    thread=threading.Thread(target=forward)
+    thread.start()
+    last_report=time.monotonic()
+    try:
+        while not (r/'sessions'/a.case/'ready.json').exists():
+            assert proc.poll() is None,'warmup failed; preserve log'
+            if time.monotonic()-last_report>=30:
+                for arm in ['base','candidate']:
+                    path=r/'sessions'/a.case/(arm+'.stderr')
+                    if path.exists():
+                        lines=path.read_text().splitlines()
+                        for line in reversed(lines):
+                            if line.startswith('{'):
+                                print('WARM',arm,line,flush=True)
+                                break
+                last_report=time.monotonic()
+            time.sleep(.2)
+        subprocess.run(['python3',str(r/'queue249.py'),a.case],check=True)
+        assert proc.wait()==0,'comparison failed; preserve artifacts'
+    finally:
+        if proc.poll() is None:
+            proc.terminate()
+            proc.wait()
+        thread.join()
+subprocess.run(['python3',str(r/'accept249.py'),str(r/'sessions'/a.case)],check=True)
