+compiler=subprocess.check_output(['rustup','which','rustc'],text=True).strip()
+env=dict(os.environ,CARGO_TARGET_DIR='/tmp/slither-food-maintenance-target-20261029',CARGO_BUILD_JOBS='1',CARGO_PROFILE_DEV_DEBUG='0',CARGO_PROFILE_TEST_DEBUG='0',CARGO_INCREMENTAL='0',CARGO_NET_OFFLINE='true',RAYON_NUM_THREADS='1',RUST_TEST_THREADS='1',RUSTC=compiler,RUSTDOC=str(Path(compiler).with_name('rustdoc')),RUSTFLAGS='-C target-cpu=native')
+env.pop('CARGO_ENCODED_RUSTFLAGS',None);os.sched_setaffinity(0,{0});rows=[]
+def run(command,label,failure=False):
+ with (out/(label+'.log')).open('x') as f:p=subprocess.run(command,cwd=source,env=env,stdout=f,stderr=subprocess.STDOUT)
+ assert (p.returncode!=0 and 'test result: FAILED' in (out/(label+'.log')).read_text()) if failure else p.returncode==0,(label,p.returncode)
+ rows.append({'label':label,'command':command,'expectedFailure':failure,'exit':p.returncode});(out/'results.json').write_text(json.dumps(rows,indent=2)+'\n');print(label,p.returncode,flush=True)
+run(['cargo','test','--locked','--lib','client::simulation::food::tests'],'food-oracles')
+command=['cargo','test','--locked','--lib','shared_diffs_match_uncached_']
+f=source/'src/client/simulation/food.rs';before=f.read_bytes()
+try:
+ text=before.decode();needle='Arc::ptr_eq(previous, &diff.previous) && Arc::ptr_eq(current, &diff.current)';assert text.count(needle)==1
+ f.write_text(text.replace(needle,'Arc::ptr_eq(current, &diff.current)'),newline='\n')
+ run(command,'ignore-previous-identity-mutation',True)
+finally:f.write_bytes(before)
+run(command,'restored-cache-oracle')
+run(['python3','tools/check.py','rust'],'rust-group')
+(r/'required-checks-pass.json').write_text(json.dumps({'passed':True,'checks':rows},indent=2)+'\n')
