+"""Compact selected pair aggregates; raw per-tick data remains private."""
+from pathlib import Path
+import hashlib,json,math,statistics,sys
+r=Path(__file__).resolve().parent
+def read(p):return json.loads(p.read_text())
+def quantile(v,p):v=sorted(v);return v[math.ceil((len(v)-1)*p)]
+def summary(rows):
+ return {'ticks':len(rows),'instructionsMean':statistics.mean(x[2] for x in rows),'cpuMsMean':statistics.mean(x[3] for x in rows)/1e6,'cpuMsP99':quantile([x[3]/1e6 for x in rows],.99)}
+result={'machine':'a 4-vCPU Zen 5 EPYC KVM guest','access':'raw ticks, complete traces, sources, binaries and command inventories local-only','rows':{},'pins':{}}
+for case in ['short','stock','legacy']:
+ root=r/'sessions'/case
+ if not (root/'accepted.json').exists():continue
+ accepted=read(root/'accepted.json');ready=accepted['warmTrace']
+ assert accepted['forkCompleteWindowBytesEqual'] and ready['warmTraceComparedEveryByte']
+ pairs=[]
+ for pair in range(5):
+  row={'pair':pair,'order':'AB' if pair%2==0 else 'BA'}
+  for arm in ['base','candidate']:
+   data=read(root/f'pair-{pair}-{arm}.json');ticks=data['ticks'];assert len(ticks)==ready['windowTicks']
+   assert all(bool(x[1])==(math.floor(x[0]*.007/.504)>math.floor((x[0]-1)*.007/.504)) for x in ticks)
+   row[arm]={'all':summary(ticks),'maintenance':summary([x for x in ticks if x[1]]),'ordinary':summary([x for x in ticks if not x[1]])}
+  for phase in ['all','maintenance','ordinary']:
+   assert row['base'][phase]['ticks']==row['candidate'][phase]['ticks']
+  pairs.append(row)
+ result['rows'][case]={'warmTicks':ready['warmTicks'],'ticksPerWindow':ready['windowTicks'],'warmBytesPerArm':ready['traceBytes']['base'],'completeWindowSha256':hashlib.file_digest((root/'proof-base-0.trace').open('rb'),'sha256').hexdigest(),'startCensus':ready['ready']['base']['summary']['census'],'endCensus':read(root/'pair-0-base.json')['summary']['census'],'pairs':pairs}
+for arm in ['base','candidate','mutation']:
+ pin=read(r/arm/'pins.json')
+ for name,value in pin['sources'].items():assert hashlib.file_digest((r/arm/'source'/name).open('rb'),'sha256').hexdigest()==value
+ for name,value in pin['binaries'].items():assert hashlib.file_digest((r/arm/'bin'/name).open('rb'),'sha256').hexdigest()==value
+ result['pins'][arm]={'commit':pin['archiveCommit'],'archiveSha256':pin['archiveSha256'],'toolchain':pin['toolchain'],'rustflags':pin['rustflags'],'rustSourcesDigest':hashlib.sha256(json.dumps(pin['sources'],sort_keys=True).encode()).hexdigest(),'binaries':pin['binaries']}
+result['catalogParity']=read(r/'parity.json');assert len(result['catalogParity'])==27
+result['mutations']=read(r/'mutation.json');assert all(v['detected'] for v in result['mutations'])
+result['checks']=read(r/'required-checks-pass.json')
+(r/'fixed-selected.json').write_text(json.dumps(result,indent=2)+'\n')
+for case,row in result['rows'].items():
+ print(case)
+ for phase in ['all','maintenance','ordinary']:
+  pairs=row['pairs'];reductions=[1-v['candidate'][phase]['instructionsMean']/v['base'][phase]['instructionsMean'] for v in pairs]
+  print(phase,'instructions',*[statistics.median(v[a][phase]['instructionsMean'] for v in pairs) for a in ['base','candidate']],'reduction',statistics.median(reductions),[min(reductions),max(reductions)],'CPU ms mean',*[statistics.median(v[a][phase]['cpuMsMean'] for v in pairs) for a in ['base','candidate']],'p99',*[statistics.median(v[a][phase]['cpuMsP99'] for v in pairs) for a in ['base','candidate']])
