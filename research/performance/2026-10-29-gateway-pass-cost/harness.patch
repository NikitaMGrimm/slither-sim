diff --git a/reduce_live.py b/reduce_live.py
new file mode 100644
--- /dev/null
+++ b/reduce_live.py
@@ -0,0 +1,69 @@
+"""Matched-order descriptive live pairs with exact per-tick maintenance flags."""
+from pathlib import Path
+import json,math,statistics,sys
+r=Path(__file__).resolve().parent
+state=json.loads((r/'series.json').read_text());assert state['status']=='complete'
+def q(values):
+ values=sorted(values);assert values
+ return {'mean':statistics.mean(values),'p50':values[math.ceil((len(values)-1)*.5)],'p99':values[math.ceil((len(values)-1)*.99)],'max':max(values)}
+def summarize(rows):
+ return {'ticks':len(rows),'gatewayCpuMs':q([v[1]/1e6 for v in rows]),
+         'simulationCpuMs':q([v[0]/1e6 for v in rows]),'worldCpuMs':q([(v[0]+v[1])/1e6 for v in rows]),
+         'tickBusyWallMs':q([v[2]/1e6 for v in rows])}
+cases={}
+for attempt in state['attempts']:
+ if not attempt.get('accepted'):continue
+ name=attempt['name'];root=r/'runs'/name
+ accepted=json.loads((r/(name+'-accepted.json')).read_text())['cases'][name]
+ meta=json.loads((root/'summary.json').read_text());assert len(meta['holds'])==1
+ hold=meta['holds'][0];census={};blocks={};foods=set()
+ for line in (root/'host.log').read_text().splitlines():
+  if line.startswith('CENSUS '):v=json.loads(line[7:]);census[v['tick']]=v
+  elif line.startswith('CAPACITY '):v=json.loads(line[9:]);blocks[v['tick']]=v
+  elif line.startswith('GATEWAY_FOOD '):foods.add(int(line.split()[1]))
+ ticks=sorted(t for t in blocks if t-100 in census and census[t-100]['unix']>=hold['startUnix'] and census[t]['unix']<=hold['endUnix'])
+ rows=[]
+ for t in ticks:
+  assert len(blocks[t]['rows'])==100
+  for i,values in enumerate(blocks[t]['rows']):
+   tick=t-99+i
+   expected=math.floor(tick*.007/.504)>math.floor((tick-1)*.007/.504)
+   assert (tick in foods)==expected,('actual epoch/cadence mismatch',tick)
+   rows.append((values,expected))
+ summary={phase:summarize([v for v,m in rows if phase=='all' or m==(phase=='maintenance')]) for phase in ['all','maintenance','ordinary']}
+ assert summary['all']['ticks']==accepted['holds'][0]['ticks']
+ for metric,key in [('worldCpuMs','worldCpuMsPerTick'),('gatewayCpuMs','socketCpuMsPerTick')]:
+  assert summary['all'][metric]==accepted['holds'][0][key],(name,metric)
+ diagnostic=accepted.get('syscallDiagnostic')
+ if diagnostic:
+  diagnostic=dict(diagnostic)
+  diagnostic['averageCpuMsPerTick']=dict(diagnostic['averageCpuMsPerTick'])
+  diagnostic['averageCpuMsPerTick']['readinessTotal']=diagnostic['averageCpuMsPerTick'].pop('readinessPoll')
+  diagnostic['limits']+=' Readiness is the whole function including array/query/registration, not a pure syscall. No separately qualified body/client/queue window; diagnostic only.'
+ cases[name]={'pair':attempt['pair'],'arm':attempt['arm'],'discarded':attempt['discarded'],
+              'summary':summary,'quality':accepted['holds'][0],'postHoldDiagnostic':diagnostic,
+              'pins':{'hostSha256':meta['hostSha256'],'clientSha256':meta['clientSha256']}}
+pairs=[]
+for pair in range(5):
+ arms={a:next(v for v in cases.values() if v['pair']==pair and v['arm']==a) for a in ['base','candidate']}
+ changes={phase:{metric:{stat:100*(arms['candidate']['summary'][phase][metric][stat]/arms['base']['summary'][phase][metric][stat]-1)
+                        for stat in ['mean','p50','p99']}
+                 for metric in ['gatewayCpuMs','worldCpuMs']}
+          for phase in ['all','maintenance','ordinary']}
+ pairs.append({'pair':pair,'order':'AB' if pair%2==0 else 'BA','arms':arms,'changePercent':changes})
+aggregates={}
+for phase in ['all','maintenance','ordinary']:
+ aggregates[phase]={}
+ for metric in ['gatewayCpuMs','worldCpuMs']:
+  aggregates[phase][metric]={}
+  for stat in ['mean','p50','p99']:
+   changes=[p['changePercent'][phase][metric][stat] for p in pairs]
+   medians={a:statistics.median(p['arms'][a]['summary'][phase][metric][stat] for p in pairs) for a in ['base','candidate']}
+   ranges={a:[min(p['arms'][a]['summary'][phase][metric][stat] for p in pairs),max(p['arms'][a]['summary'][phase][metric][stat] for p in pairs)] for a in ['base','candidate']}
+   aggregates[phase][metric][stat]={'medianPerArm':medians,'rangePerArm':ranges,'pairedChangePercent':{'median':statistics.median(changes),'range':[min(changes),max(changes)]}}
+output={'machine':'a 4-vCPU Zen 5 EPYC KVM guest','limits':'Independent live cohorts, five alternating pairs after one discarded AB pair; descriptive, not deterministic paired worlds or a capacity qualification. Actual food epochs verified against each selected tick. Component quantiles never added.',
+        'pairs':pairs,'aggregates':aggregates,'discarded':[v for v in cases.values() if v['discarded']],
+        'failedAttempts':[v for v in state['attempts'] if not v.get('accepted')],
+        'seriesCpuSeconds':state['cpuSeconds'],'cpuCeilingHours':state['cpuCeilingHours']}
+(r/'live-selected.json').write_text(json.dumps(output,indent=2)+'\n')
+print(json.dumps(aggregates,indent=2),flush=True)
