@@ -0,0 +1,66 @@
+"""Twelve independent mature cohorts: discard AB, five alternating pairs."""
+from pathlib import Path
+import hashlib,json,os,resource,signal,subprocess,time
+r=Path(__file__).resolve().parent;os.sched_setaffinity(0,{3})
+assert not Path('/tmp/slither-gateway-round3-target').exists()
+assert not (r/'series.json').exists()
+for arm in ['base','candidate']:
+ pin=json.loads((r/arm/'pins.json').read_text())
+ assert hashlib.file_digest((r/arm/'bin/host').open('rb'),'sha256').hexdigest()==pin['binaries']['host']
+old_receipt=r/'attribution-controller-v2.json'
+# The attribution sampler has already stopped; start a fresh combined log so
+# the unchanged selector can find context around every new live window.
+assert (r/'CORE_STOP').exists();(r/'CORE_STOP').unlink()
+with (r/'series-core.log').open('xb') as log:
+ sampler=subprocess.Popen(['python3',str(r/'core_cpu.py')],stdin=subprocess.DEVNULL,stdout=log,stderr=subprocess.STDOUT,start_new_session=True)
+state={'startedUnix':time.time(),'cpuCeilingHours':12,'warmupCeilingSeconds':2700,'samplerPid':sampler.pid,'attempts':[],
+       'budgetBasis':'Mature attribution ended with 890.37 host +1562.54 client CPU seconds (~0.681 CPUh/cohort); twelve independent cohorts project ~8.18 CPUh. 12 CPUh bounds class retries and normal variation. Builds/checks precede series.'}
+save=lambda:(r/'series.json').write_text(json.dumps(state,indent=2)+'\n')
+def usage():
+ v=resource.getrusage(resource.RUSAGE_CHILDREN);return v.ru_utime+v.ru_stime
+def active_host_client_cpu(name):
+ # Reuse the runner's existing telemetry rather than issue status probes in a
+ # counted window. Process counters include each arm's complete warmup.
+ p=r/'runs'/name/'telemetry.jsonl'
+ if not p.exists():return 0
+ with p.open('rb') as f:
+  f.seek(0,2);end=f.tell();f.seek(max(0,end-65536));lines=f.read().splitlines(keepends=True)
+ for line in reversed(lines):
+  if not line.endswith(b'\n'):continue
+  try:sample=json.loads(line)
+  except json.JSONDecodeError:continue
+  return sum(sample[a]['process'][k] for a in ['server','client'] for k in ['user','system'])
+ return 0
+save()
+try:
+ for pair in range(-1,5):
+  order=['base','candidate'] if pair<0 or pair%2==0 else ['candidate','base']
+  for arm in order:
+   for attempt in [1,2]:
+    assert usage()<12*3600,'series CPU ceiling reached before cohort'
+    name=f'pair-{pair}-{arm}-attempt-{attempt}'
+    row={'pair':pair,'arm':arm,'attempt':attempt,'name':name,'discarded':pair<0,'cpuBefore':usage()};state['attempts'].append(row);save()
+    with (r/(name+'-controller.log')).open('xb') as log:
+     proc=subprocess.Popen(['python3',str(r/'run.py'),arm,name,'500','--short-mature'],stdout=log,stderr=subprocess.STDOUT,stdin=subprocess.DEVNULL)
+     while proc.poll() is None:
+      if usage()+active_host_client_cpu(name)>=12*3600:
+       proc.send_signal(signal.SIGINT);proc.wait();raise AssertionError('series CPU ceiling reached inside cohort; partial retained')
+      time.sleep(.5)
+     assert proc.wait()==0,'cohort runtime failure; preserve and stop'
+    row['cpuAfter']=usage();save();assert usage()<12*3600,'series CPU ceiling exceeded; preserve collected data'
+    selected=r/(name+'-accepted.json')
+    with (r/(name+'-selection.log')).open('xb') as log:
+     p=subprocess.run(['python3',str(r/'select.py'),str(r),str(selected),name],stdout=log,stderr=subprocess.STDOUT)
+    if p.returncode==0:
+     row['accepted']=True;save()
+     accepted=json.loads(selected.read_text())['cases'][name]['holds'][0]
+     print('ACCEPTED',name,'cpuHours',round(usage()/3600,3),'world',accepted['worldCpuMsPerTick'],'gateway',accepted['socketCpuMsPerTick'],flush=True);break
+    row['accepted']=False;row['selectionFailure']=(r/(name+'-selection.log')).read_text();save()
+    assert attempt==1 and 'mature length class drift' in row['selectionFailure'],'non-class failure; no retry or timing-based substitution'
+    print('CLASS RETRY',name,flush=True)
+   else:raise AssertionError('both class attempts failed')
+ state['status']='complete';state['cpuSeconds']=usage();save();print('SERIES COMPLETE',flush=True)
+except BaseException as exc:
+ state['status']='failed';state['failureType']=type(exc).__name__;state['failure']=str(exc);save();raise
+finally:
+ (r/'CORE_STOP').touch();sampler.wait(timeout=10);state['cpuSeconds']=usage();save()
