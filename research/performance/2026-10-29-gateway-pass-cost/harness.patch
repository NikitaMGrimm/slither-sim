new file mode 100644
--- /dev/null
+++ b/gateway_costs.rs
@@ -0,0 +1,29 @@
+// Archived diagnostic only. Coordinates are the socket thread's CPU clock.
+use std::{cell::RefCell, fs::OpenOptions, io::{BufWriter,Write}, sync::atomic::{AtomicU8,Ordering}};
+const COUNTS:usize=15;
+pub static MODE:AtomicU8=AtomicU8::new(0);
+unsafe extern "C" {fn clock_gettime(id:i32,t:*mut Time)->i32;}
+#[repr(C)]struct Time{sec:i64,ns:i64}
+fn cpu()->u64{let mut t=Time{sec:0,ns:0};assert_eq!(unsafe{clock_gettime(3,&mut t)},0);t.sec as u64*4_000_000_000+t.ns as u64}
+#[derive(Default)]struct Data{counts:[u64;COUNTS],records:Vec<[u64;4+COUNTS]>,opened:bool}
+thread_local!{static DATA:RefCell<Data>=RefCell::new(Data::default());}
+pub fn configure(){let mode=std::env::var_os("CAPACITY_GATEWAY").and_then(|p|std::fs::read_to_string(p).ok()).and_then(|s|s.trim().parse().ok()).unwrap_or(0);assert!(mode<=2);MODE.store(mode,Ordering::Relaxed);}
+pub fn mode()->u8{MODE.load(Ordering::Relaxed)}
+pub fn event(i:usize,n:u64){if mode()!=0{DATA.with_borrow_mut(|s|s.counts[i]+=n);}}
+pub struct Guard{stage:usize,start:u64,mode:u8,counts:[u64;COUNTS]}
+impl Guard{
+ pub fn new(stage:usize)->Self{let mode=mode();let enabled=mode!=0&&(stage<12||stage==18||stage==20||mode==2);Self{stage,start:if enabled{cpu()}else{0},mode,counts:if enabled{DATA.with_borrow(|s|s.counts)}else{[0;COUNTS]}}}
+}
+impl Drop for Guard{fn drop(&mut self){if self.start==0{return;}let end=cpu();DATA.with_borrow_mut(|s|{assert!(s.records.len()<4_000_000,"diagnostic record ceiling");let mut row=[0;4+COUNTS];row[0]=self.mode as u64;row[1]=self.stage as u64;row[2]=self.start;row[3]=end;for i in 0..COUNTS{row[4+i]=s.counts[i]-self.counts[i];}s.records.push(row);});}}
+fn dump(terminal:bool){DATA.with_borrow_mut(|s|{
+ if s.records.is_empty()&&!terminal{return;}
+ let path=std::env::var_os("CAPACITY_GATEWAY_TRACE").expect("diagnostic trace path");
+ let file=if s.opened{OpenOptions::new().append(true).open(path)}else{OpenOptions::new().write(true).create_new(true).open(path)}.unwrap();s.opened=true;
+ let mut out=BufWriter::with_capacity(1<<20,file);
+ out.write_all(b"GWCPU003").unwrap();out.write_all(&(s.records.len() as u64).to_le_bytes()).unwrap();
+ for row in s.records.drain(..){for value in row{out.write_all(&value.to_le_bytes()).unwrap();}}
+ if terminal{out.write_all(b"GWCPUDON").unwrap();}out.flush().unwrap();
+});}
+pub fn checkpoint(){if mode()==0{dump(false);}}
+pub struct Finish;
+impl Drop for Finish{fn drop(&mut self){dump(true);}}
