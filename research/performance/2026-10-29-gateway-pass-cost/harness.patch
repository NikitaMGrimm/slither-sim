+"""CPU-coordinate attribution; reuse the checkpoint's per-window quality gates."""
+from pathlib import Path
+import bisect,json,math,statistics,struct,sys
+from collections import deque
+
+STAGES=['pollPass','rearm','accept','deliveryPoll','readinessBuild','pollSyscall',
+        'service','flush','retainIndex','occupancy','nextDeadline','deliveryWait',
+        'transportRead','transportWrite','websocketRead','websocketWrite',
+        'websocketClose','websocketFlush','channelWait']
+COUNTS=['sessions','flushCalls','provenEmptyFlushCalls','possibleFlushCalls',
+        'websocketWrites','transportWrites','transportWrittenBytes','writeBlocks',
+        'transportReads','transportReadBytes','readBlocks','websocketReads',
+        'acceptAttempts','deliveredFrames','dueFrames']
+
+def overlaps(start,end,rows,ends):
+    """Yield exact CPU overlap, including flat clocks and selected-window gaps."""
+    i=bisect.bisect_right(ends,start)
+    while i<len(rows) and rows[i]['cpuStart']<end:
+        row=rows[i];n=max(0,min(end,row['cpuEnd'])-max(start,row['cpuStart']))
+        if n:yield row,n
+        i+=1
+
+def decode_cpu(value,seconds_scale):
+    # The retained module used a 4e9 seconds multiplier after a record-limit edit.
+    # clock_gettime's fractional part is strictly below 1e9, making this inverse
+    # exact; no interpolation, timing correction or overhead subtraction occurs.
+    seconds,nanos=divmod(value,seconds_scale)
+    assert 0<=nanos<1_000_000_000,(value,seconds_scale,nanos)
+    return seconds*1_000_000_000+nanos
+
+def records(path,seconds_scale):
+    with path.open('rb') as f:
+        while magic:=f.read(8):
+            if magic==b'GWCPUDON':continue
+            assert magic==b'GWCPU003',(path,magic)
+            size=f.read(8);assert len(size)==8
+            for _ in range(struct.unpack('<Q',size)[0]):
+                data=f.read(152);assert len(data)==152,'truncated CPU record'
+                values=list(struct.unpack('<19Q',data))
+                values[2]=decode_cpu(values[2],seconds_scale)
+                values[3]=decode_cpu(values[3],seconds_scale)
+                assert values[0] in [1,2] and values[3]>=values[2]
+                yield values
+
+def quantile(values,p):
+    values=sorted(values);assert values
+    return values[math.ceil((len(values)-1)*p)]
+
+def summary(rows):
+    assert rows
+    phases={}
+    nested=['transportReadInWebsocketRead','transportWriteInWebsocketRead',
+            'transportWriteInWebsocketWrite','transportWriteInWebsocketClose',
+            'transportWriteInWebsocketFlush']
+    for name in [*STAGES,'flushEmptyOnlyLoop','flushPossiblyPendingLoop',*nested]:
+        values=[row['phases'].get(name,0)/1e6 for row in rows]
+        phases[name]={'mean':statistics.mean(values),'p50':quantile(values,.5),'p99':quantile(values,.99)}
+    # Inclusive parents are never added to their children.
+    disjoint=['rearm','accept','deliveryPoll','readinessBuild','pollSyscall',
+              'service','flush','retainIndex','occupancy','nextDeadline',
+              'deliveryWait','channelWait']
+    residual=[(row['socket']-sum(row['phases'].get(s,0) for s in disjoint))/1e6 for row in rows]
+    assert min(residual)>-0.00001,('overlapping disjoint phase intervals',min(residual))
+    exclusive={}
+    for parent,children in [('websocketRead',nested[:2]),('websocketWrite',nested[2:3]),
+                            ('websocketClose',nested[3:4]),('websocketFlush',nested[4:5])]:
+        values=[(r['phases'].get(parent,0)-sum(r['phases'].get(c,0) for c in children))/1e6 for r in rows]
+        assert min(values)>-0.00001,(parent,min(values))
+        exclusive[parent]={'mean':statistics.mean(values),'p50':quantile(values,.5),'p99':quantile(values,.99)}
+    return {'ticks':len(rows),'socketCpuMs':{'mean':statistics.mean(r['socket']/1e6 for r in rows),'p50':quantile([r['socket']/1e6 for r in rows],.5),'p99':quantile([r['socket']/1e6 for r in rows],.99)},
+            'worldCpuMs':{'mean':statistics.mean(r['world']/1e6 for r in rows),'p50':quantile([r['world']/1e6 for r in rows],.5),'p99':quantile([r['world']/1e6 for r in rows],.99)},
+            'phaseCpuMs':phases,'websocketCpuExcludingTransportMs':exclusive,'unassignedCpuMsMean':statistics.mean(residual)}
+
+def main(root,case):
+    run=root/'runs'/case;meta=json.loads((run/'summary.json').read_text());assert meta['status']=='complete'
+    smoke=meta['count']!=500
+    # Read the actual archived implementation; fail on an unrecognized encoding.
+    module=(root/meta['arm']/'source/src/gateway_costs.rs').read_text()
+    import re
+    match=re.search(r't\.sec as u64\*([0-9_]+)\+t\.ns as u64',module);assert match
+    seconds_scale=int(match[1].replace('_',''));assert seconds_scale in [1_000_000_000,4_000_000_000]
+    # Reuse every original quality predicate. Select each diagnostic mode
+    # independently; a fine-timer failure cannot silently validate or erase coarse.
+    original=(root/'select.py').read_text()
+    original=original[:original.index("selected={'machine'")]
+    needle=" for h in meta['holds']:"
+    assert original.count(needle)==1
+    original=original.replace(needle," for h in meta['holds'][hold_index:hold_index+1]:")
+    argv=sys.argv;sys.argv=['select.py',str(root),'unused.json']+(['--preflight'] if smoke else [])
+    quality=[]
+    try:
+        for index in range(3):
+            scope={'__file__':str(root/'select.py'),'__name__':'reused_quality','hold_index':index}
+            exec(compile(original,str(root/'select.py'),'exec'),scope)
+            try:
+                accepted=scope['reduce'](case)
+                quality.append({'mode':index,'passed':True,'selection':accepted['holds'][0]})
+            except (AssertionError,IndexError,ValueError) as error:
+                quality.append({'mode':index,'passed':False,'failure':str(error)})
+    finally:sys.argv=argv
+    census={};blocks={};foods=set()
+    for line in (run/'host.log').read_text().splitlines():
+        if line.startswith('CENSUS '):v=json.loads(line[7:]);census[v['tick']]=v
+        elif line.startswith('CAPACITY '):v=json.loads(line[9:]);blocks[v['tick']]=v
+        elif line.startswith('GATEWAY_FOOD '):foods.add(int(line.split()[1]))
+    rows=[]
+    for index,h in enumerate(meta['holds']):
+        for tick,b in sorted(blocks.items()):
+            if tick-100 not in census:continue
+            if census[tick-100]['unix']<h['startUnix']+(0 if smoke else 1.5) or census[tick]['unix']>h['endUnix']-(0 if smoke else .5):continue
+            assert len(b['rows'])==len(b['gateway'])==100
+            if any(v[3]!=index for v in b['gateway']):continue
+            for clocks,coords in zip(b['rows'],b['gateway']):
+                t,start,end,mode=coords
+                assert end-start==clocks[1] and start<=end
+                rows.append({'tick':t,'mode':mode,'cpuStart':start,'cpuEnd':end,'socket':clocks[1],
+                             'world':clocks[0]+clocks[1],'maintenance':t in foods,'phases':{}})
+    rows.sort(key=lambda x:x['cpuStart']);assert rows
+    assert all(a['cpuEnd']<=b['cpuStart'] for a,b in zip(rows,rows[1:]))
