diff --git a/reduce_incomplete.py b/reduce_incomplete.py
new file mode 100644
--- /dev/null
+++ b/reduce_incomplete.py
@@ -0,0 +1,121 @@
+"""Retain a failed isolation gate without qualifying or replacing its window."""
+from pathlib import Path
+import bisect,json,math,re,shutil,statistics,sys,tarfile
+
+r=Path(__file__).resolve().parent
+root=r/'incomplete-analysis';root.mkdir(exist_ok=True)
+with tarfile.open(r/'final-complete.tar.gz') as archive:
+ state=json.load(archive.extractfile('series.json'))
+ assert state['status']=='failed' and len(state['attempts'])==4
+ names=[a['name'] for a in state['attempts']]
+ files=['series.json','select.py','core-telemetry.jsonl']
+ for name in names:
+  assert re.fullmatch(r'pair--?\d+-(?:base|candidate)-attempt-\d+',name)
+  files.extend('runs/'+name+'/'+file for file in ['summary.json','host.log','client.log','telemetry.jsonl',
+      'hold-0-start-processes.txt','hold-0-end-processes.txt'])
+ for name in files:
+  file=root/name;file.parent.mkdir(parents=True,exist_ok=True);file.write_bytes(archive.extractfile(name).read())
+ accepted={a['name']:json.load(archive.extractfile(a['name']+'-accepted.json'))['cases'][a['name']]
+           for a in state['attempts'] if a.get('accepted')}
+shared=root/'shared248';shared.mkdir(exist_ok=True)
+prior=Path(sys.argv[1]) if len(sys.argv)>1 else r.parents[1]/'research/performance/2026-10-28-official-density-capacity/select_results.py'
+shutil.copyfile(prior,shared/'select_results.py')
+code=(root/'select.py').read_text();code=code[:code.index("selected={'machine'")]
+needle="   assert row['backgroundProcessScreen']['passes'],'competing process CPU'"
+assert code.count(needle)==1
+# Analysis only: expose the original rejected row after recording its failure.
+# No accepted receipt is written, and this does not feed the primary reducer.
+code=code.replace(needle,'   # Original isolation gate failure is retained by this diagnostic.')
+scope={'__file__':str(root/'select.py'),'__name__':'failed_gate_diagnostic'}
+saved_argv=sys.argv;sys.argv=['select.py',str(root),'unused.json']
+try:exec(compile(code,str(root/'select.py'),'exec'),scope)
+finally:sys.argv=saved_argv
+failed=state['attempts'][-1]
+assert 'competing process CPU' in failed['selectionFailure'] and not failed.get('accepted')
+diagnostic=scope['reduce'](failed['name'])
+assert len(diagnostic['holds'])==1
+screen=diagnostic['holds'][0]['backgroundProcessScreen'];assert not screen['passes']
+
+def q(values):
+ values=sorted(values);assert values
+ return {key:(statistics.mean(values) if key=='mean' else values[math.ceil((len(values)-1)*fraction)])
+         for key,fraction in [('mean',0),('p50',.5),('p99',.99)]}
+
+def split(name,quality):
+ meta=json.loads((root/'runs'/name/'summary.json').read_text());hold=meta['holds'][0]
+ census={};blocks={};foods=set()
+ for line in (root/'runs'/name/'host.log').read_text().splitlines():
+  if line.startswith('CENSUS '):v=json.loads(line[7:]);census[v['tick']]=v
+  elif line.startswith('CAPACITY '):v=json.loads(line[9:]);blocks[v['tick']]=v
+  elif line.startswith('GATEWAY_FOOD '):foods.add(int(line.split()[1]))
+ ticks=sorted(t for t in blocks if t-100 in census and census[t-100]['unix']>=hold['startUnix'] and census[t]['unix']<=hold['endUnix'])
+ rows=[]
+ for t in ticks:
+  assert len(blocks[t]['rows'])==100
+  for i,values in enumerate(blocks[t]['rows']):
+   tick=t-99+i;m=math.floor(tick*.007/.504)>math.floor((tick-1)*.007/.504)
+   assert (tick in foods)==m,(name,tick)
+   rows.append((values,m))
+ result={}
+ for phase in ['all','maintenance','ordinary']:
+  selected=[v for v,m in rows if phase=='all' or m==(phase=='maintenance')]
+  result[phase]={'ticks':len(selected),'gatewayCpuMs':q([v[1]/1e6 for v in selected]),
+       'worldCpuMs':q([(v[0]+v[1])/1e6 for v in selected])}
+ assert result['all']['ticks']==quality['ticks']
+ for metric,key in [('gatewayCpuMs','socketCpuMsPerTick'),('worldCpuMs','worldCpuMsPerTick')]:
+  assert all(result['all'][metric][stat]==quality[key][stat] for stat in ['mean','p50','p99'])
+ return result
+
+cases={}
+for name,case in [*accepted.items(),(failed['name'],diagnostic)]:
+ attempt=next(a for a in state['attempts'] if a['name']==name)
+ cases[name]={'arm':attempt['arm'],'discarded':attempt['discarded'],
+     'qualifiedPrimary':False,'selectorPassed':bool(attempt.get('accepted')),
+     'exclusion':'discarded control' if attempt['discarded'] else 'failed competing-process CPU gate',
+     'summary':split(name,case['holds'][0]),'quality':case['holds'][0]}
+
+# Diagnose the isolation maximum using exactly the selector's sampled endpoints.
+name=failed['name'];meta=json.loads((root/'runs'/name/'summary.json').read_text());hold=meta['holds'][0]
+census={};capacity={}
+for line in (root/'runs'/name/'host.log').read_text().splitlines():
+ if line.startswith('CENSUS '):v=json.loads(line[7:]);census[v['tick']]=v
+ elif line.startswith('CAPACITY '):v=json.loads(line[9:]);capacity[v['tick']]=v
+ticks=sorted(t for t in capacity if t-100 in census and census[t-100]['unix']>=hold['startUnix'] and census[t]['unix']<=hold['endUnix'])
+start=census[ticks[0]-100]['unix'];end=census[ticks[-1]]['unix']
+core=scope['core_data']();times=[v['unix'] for v in core]
+before=core[bisect.bisect_right(times,start)-1]['processes'];after=core[bisect.bisect_right(times,end)-1]['processes']
+old={v['pid']:v for v in before}
+other=[(v['cpu']-old[v['pid']]['cpu'],v['pid']) for v in after if v['pid'] in old and old[v['pid']]['start']==v['start'] and not v['study'] and not v['kernel']]
+maximum,pid=max(other)
+assert maximum==screen['largestOtherUserProcessCpuSeconds']
+observed=sorted({round(v['cpu']*1e9) for row in core for v in row['processes'] if v['pid']==pid})
+quantum=math.gcd(*(b-a for a,b in zip(observed,observed[1:])))
+assert quantum==10_000_000
+screen['observedOtherProcessCpuQuantumSeconds']=quantum/1e9
+# Retain only an executable basename, never its arguments or account fields.
+program=None
+for line in (root/'runs'/name/'hold-0-start-processes.txt').read_text().splitlines():
+ fields=line.split(None,4)
+ if len(fields)==5 and fields[0]==str(pid):
+  program=Path(fields[4].split()[0]).name
+  assert re.fullmatch(r'[a-zA-Z0-9_.-]+',program)
+  break
+output={'machine':'a 4-vCPU Zen 5 EPYC KVM guest','status':'unqualified; no primary pair completed',
+ 'limits':'Discarded controls and one isolation-failed base window only. No before/after performance conclusion; no failed window is promoted. Actual food flags are checked for every reduced tick.',
+ 'seriesCpuSeconds':state['cpuSeconds'],'cpuCeilingHours':state['cpuCeilingHours'],
+ 'attempts':[{k:a[k] for k in ['pair','arm','attempt','name','discarded','accepted']} for a in state['attempts']],
+ 'isolationFailure':dict(screen,programBasename=program,selectedWallSeconds=end-start),
+ 'cases':cases,'completedPrimaryPairs':0}
+bad=next(a for a in state['attempts'] if 'mature length class drift' in a.get('selectionFailure',''))
+meta=json.loads((root/'runs'/bad['name']/'summary.json').read_text());hold=meta['holds'][0]
+census={};capacity={}
+for line in (root/'runs'/bad['name']/'host.log').read_text().splitlines():
+ if line.startswith('CENSUS '):v=json.loads(line[7:]);census[v['tick']]=v
+ elif line.startswith('CAPACITY '):v=json.loads(line[9:]);capacity[v['tick']]=v
+ticks=sorted(t for t in capacity if t-100 in census and census[t-100]['unix']>=hold['startUnix'] and census[t]['unix']<=hold['endUnix'])
+lengths=[census[ticks[0]-100],*[census[t] for t in ticks]]
+output['classFailure']={'name':bad['name'],'censusSamples':len(lengths),
+ 'ranges':{key:[min(v[key] for v in lengths),max(v[key] for v in lengths)] for key in ['living','meanSegments','p90Segments','p99Segments']}}
+(r/'live-incomplete.json').write_text(json.dumps(output,indent=2)+'\n',newline='\n')
+print(json.dumps({'isolationFailure':output['isolationFailure'],'seriesCpuHours':state['cpuSeconds']/3600,
+ 'cases':{k:v['summary'] for k,v in cases.items()}},indent=2))
diff --git a/archive_final.py b/archive_final.py
