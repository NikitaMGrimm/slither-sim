--- /dev/null
+++ b/archive_final.py
@@ -0,0 +1,66 @@
+"""Verify, preserve and remove only this completed task's guest artifacts."""
+from pathlib import Path
+import hashlib,json,os,pwd,shutil,subprocess,sys,tarfile
+
+r=Path(__file__).resolve().parent
+assert r==Path('/tmp/slither-gateway-round3-20261029') and r.resolve()==r
+archive=r.with_name(r.name+'-final.tar.gz')
+target=Path('/tmp/slither-gateway-round3-target')
+sha=lambda p:hashlib.file_digest(p.open('rb'),'sha256').hexdigest()
+
+def idle():
+    assert not target.exists()
+    assert (r/'CORE_STOP').exists()
+    active=[]
+    for p in Path('/proc').glob('[0-9]*'):
+        try:
+            if int(p.name)==os.getpid():continue
+            command=(p/'cmdline').read_bytes().split(b'\0')
+            if any(arg.startswith(str(r).encode()+b'/') for arg in command):active.append(int(p.name))
+        except (FileNotFoundError,PermissionError,ProcessLookupError):pass
+    assert not active,('task processes remain',active)
+    return active
+
+def anonymous(member):
+    member.uid=member.gid=0;member.uname=member.gname='';return member
+
+idle()
+if sys.argv[1]=='pack':
+    assert not archive.exists()
+    state=json.loads((r/'series.json').read_text());assert state['status'] in ['complete','failed']
+    pins={}
+    for arm in ['base','candidate']:
+        pin=json.loads((r/arm/'pins.json').read_text())
+        assert sha(r/arm/'bin/host')==pin['binaries']['host']
+        assert {str(p.relative_to(r/arm/'source')):sha(p) for p in (r/arm/'source/src').rglob('*.rs')}==pin['overlays']
+        pins[arm]={'commit':pin['commit'],'hostSha256':pin['binaries']['host']}
+    common=r/'common-client';client_pin=json.loads((common/'pins.json').read_text())
+    assert sha(common/'bin/clients')==client_pin['binarySha256']
+    commands=subprocess.check_output(['ps','-eo','pid,ppid,stat,pcpu,args','-ww'],text=True)
+    commands=commands.replace(pwd.getpwuid(os.getuid()).pw_name,'<redacted-account>')
+    (r/'final-boundary-processes.txt').write_text(commands)
+    (r/'final-boundary.json').write_text(json.dumps({'seriesStatus':state['status'],'taskProcesses':[],
+        'targetAbsent':True,'pins':pins,'client':client_pin},indent=2)+'\n')
+    with tarfile.open(archive,'x:gz',compresslevel=1) as t:
+        for p in sorted(r.iterdir()):t.add(p,arcname=p.name,filter=anonymous)
+        # The common client is a read-only donor symlink in the execution tree.
+        # Preserve its actual source/binary/pins too, without mutating the donor.
+        if common.is_symlink():t.add(common.resolve(),arcname='retained-common-client',filter=anonymous)
+    print(json.dumps({'sha256':sha(archive),'bytes':archive.stat().st_size,'seriesStatus':state['status']}),flush=True)
+elif sys.argv[1]=='prune':
+    assert sha(archive)==sys.argv[2]
+    files={str(p.relative_to(r)):p for p in r.rglob('*') if p.is_file() or p.is_symlink()};seen=set()
+    with tarfile.open(archive,'r|gz') as t:
+        for m in t:
+            if m.name not in files:continue
+            p=files[m.name]
+            if p.is_symlink():assert m.issym() and m.linkname==str(p.readlink())
+            else:
+                assert p.resolve().is_relative_to(r) and m.isfile() and m.size==p.stat().st_size
+                assert hashlib.file_digest(t.extractfile(m),'sha256').hexdigest()==sha(p)
+            seen.add(m.name)
+    assert seen==files.keys(),sorted(files.keys()-seen)
+    idle()
+    receipt={'verifiedSha256':sys.argv[2],'taskRootRemoved':str(r),'targetAbsent':True,'taskProcesses':[],'filesVerified':len(files)}
+    shutil.rmtree(r);archive.unlink();print(json.dumps(receipt),flush=True)
+else:raise AssertionError(sys.argv[1])
