+"""Forward existing cohort/controller logs; no process/status sampling."""
+from pathlib import Path
+import os,time
+r=Path(__file__).resolve().parent;os.sched_setaffinity(0,{3});offsets={}
+while True:
+ paths=[r/'series-controller.log',*sorted(r.glob('pair-*-controller.log'))]
+ for p in paths:
+  if not p.exists():continue
+  with p.open() as f:f.seek(offsets.get(p,0));text=f.read();offsets[p]=f.tell()
