@@ -0,0 +1,32 @@
+import unittest
+from analyze import overlaps,summary,decode_cpu
+
+class AttributionTests(unittest.TestCase):
+    def test_encoded_seconds_recover_exactly_across_second_boundaries(self):
+        for sec,nanos in [(0,0),(0,999_999_999),(1,0),(387,935_483_934),(404,999_999_999)]:
+            self.assertEqual(decode_cpu(sec*4_000_000_000+nanos,4_000_000_000),sec*1_000_000_000+nanos)
+        with self.assertRaises(AssertionError):decode_cpu(1_000_000_000,4_000_000_000)
+    def test_crossing_phase_splits_in_cpu_time_with_selected_gaps(self):
+        rows=[{'cpuStart':10,'cpuEnd':20},{'cpuStart':20,'cpuEnd':20},
+              {'cpuStart':20,'cpuEnd':40},{'cpuStart':60,'cpuEnd':80}]
+        ends=[r['cpuEnd'] for r in rows]
+        self.assertEqual([n for _,n in overlaps(15,70,rows,ends)],[5,20,10])
+        self.assertEqual(sum(n for _,n in overlaps(15,70,rows,ends)),35)
+        self.assertEqual(list(overlaps(40,60,rows,ends)),[])
+        self.assertEqual(list(overlaps(80,90,rows,ends)),[])
+    def test_exclusive_end_and_a_phase_inside_one_tick(self):
+        rows=[{'cpuStart':0,'cpuEnd':10},{'cpuStart':10,'cpuEnd':20}]
+        self.assertEqual([n for _,n in overlaps(2,9,rows,[10,20])],[7])
+        self.assertEqual([n for _,n in overlaps(0,10,rows,[10,20])],[10])
+    def test_inclusive_parents_are_not_added_to_the_disjoint_budget(self):
+        row={'socket':100,'world':200,'phases':{'pollPass':80,'rearm':10,'service':50,'flush':20}}
+        self.assertAlmostEqual(summary([row])['unassignedCpuMsMean'],20/1e6)
+    def test_transport_is_subtracted_only_from_its_containing_websocket_call(self):
+        row={'socket':100,'world':200,'phases':{'flush':80,'websocketFlush':60,
+             'transportWrite':80,'transportWriteInWebsocketFlush':40}}
+        self.assertAlmostEqual(summary([row])['websocketCpuExcludingTransportMs']['websocketFlush']['mean'],20/1e6)
+    def test_world_quantile_uses_aligned_sums(self):
+        rows=[{'socket':0,'world':100,'phases':{}},{'socket':60,'world':100,'phases':{}}]
+        self.assertAlmostEqual(summary(rows)['worldCpuMs']['p99'],100/1e6)
+
+if __name__=='__main__':unittest.main()
