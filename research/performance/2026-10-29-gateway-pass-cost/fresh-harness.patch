@@ -0,0 +1,61 @@
+"""Guest-only diagnosis of the stopped fresh series, with no promoted window."""
+from pathlib import Path
+import bisect,json,math,statistics,sys
+r=Path(__file__).resolve().parent
+state=json.loads((r/'series.json').read_text());assert state['status']=='failed'
+failed=[a for a in state['attempts'] if not a.get('accepted')]
+assert len(failed)==1 and 'competing process CPU' in failed[0]['selectionFailure']
+bad=failed[0]
+selector=(r/'select.py').read_text();selector=selector[:selector.index("selected={'machine'")]
+needle="   assert row['backgroundProcessScreen']['passes'],'competing process CPU'"
+assert selector.count(needle)==1
+selector=selector.replace(needle,'   # Diagnostic exposes the failed screen; acceptance stays false.')
+scope={'__file__':str(r/'select.py'),'__name__':'failed_fresh_diagnostic'}
+saved=sys.argv;sys.argv=['select.py',str(r),'unused.json']
+try:exec(compile(selector,str(r/'select.py'),'exec'),scope)
+finally:sys.argv=saved
+diagnostic=scope['reduce'](bad['name'])
+screen=diagnostic['holds'][0]['backgroundProcessScreen'];assert not screen['passes']
+
+# Reuse the full-series math and exact-food-flag checks by reference. Only expose
+# the already-rejected isolation row; never write a new accepted receipt.
+source=(r/'reduce_live.py').read_text()
+body=source[source.index('def q(values):'):source.index('pairs=[]')]
+needle=" if not attempt.get('accepted'):continue"
+assert body.count(needle)==1
+body=body.replace(needle," if not attempt.get('accepted') and attempt['name']!=bad['name']:continue")
+needle=" accepted=json.loads((r/(name+'-accepted.json')).read_text())['cases'][name]"
+assert body.count(needle)==1
+body=body.replace(needle," accepted=rejected_case if name==bad['name'] else json.loads((r/(name+'-accepted.json')).read_text())['cases'][name]")
+math_scope={'r':r,'state':state,'bad':bad,'rejected_case':diagnostic,'json':json,'math':math,'statistics':statistics}
+exec(compile(body,str(r/'reduce_live.py'),'exec'),math_scope)
+cases=math_scope['cases']
+for name,case in cases.items():
+ attempt=next(a for a in state['attempts'] if a['name']==name)
+ case['selectorPassed']=bool(attempt.get('accepted'))
+ case['qualifiedPrimary']=case['selectorPassed'] and not case['discarded']
+ case['exclusion']='discarded control' if case['discarded'] else ('failed isolation gate' if not case['selectorPassed'] else None)
+paired=[]
+for pair in range(5):
+ arms={a:next((v for v in cases.values() if v['pair']==pair and v['arm']==a and v['qualifiedPrimary']),None) for a in ['base','candidate']}
+ if not all(arms.values()):continue
+ changes={phase:{metric:{stat:100*(arms['candidate']['summary'][phase][metric][stat]/arms['base']['summary'][phase][metric][stat]-1)
+                        for stat in ['mean','p50','p99']}
+                 for metric in ['gatewayCpuMs','worldCpuMs']}
+          for phase in ['all','maintenance','ordinary']}
+ paired.append({'pair':pair,'order':'AB' if pair%2==0 else 'BA','arms':arms,'changePercent':changes})
+assert len(paired)<5
+output={'machine':'a 4-vCPU Zen 5 EPYC KVM guest','seriesIdentity':'fresh-quantum',
+ 'frozenPlanCommit':state['frozenPlanCommit'],'status':'stopped at frozen non-class gate',
+ 'seriesCpuSeconds':state['cpuSeconds'],'cpuCeilingHours':state['cpuCeilingHours'],
+ 'wallSeconds':max(json.loads((r/'runs'/a['name']/'summary.json').read_text())['diagnosticEndUnix'] for a in state['attempts'])-state['startedUnix'],
+ 'completedPrimaryPairs':len(paired),'pairs':paired,'cases':cases,'isolationFailure':screen,
+ 'adoption':{'adopt':False,'completeFivePairs':False,'fivePairGatewayRangeTest':'unavailable',
+             'reason':'fresh series stopped at its frozen isolation gate before five qualified pairs'},
+ 'attempts':[{k:a[k] for k in ['pair','arm','attempt','name','discarded','accepted']} for a in state['attempts']],
+ 'limits':'Only qualified complete pairs are paired; discarded controls and the rejected candidate stay excluded. In-memory diagnostic exposure of a failed isolation assertion never changes acceptance. No five-pair performance conclusion.'}
+(r/'fresh-partial.json').write_text(json.dumps(output,indent=2)+'\n')
+print(json.dumps({'cpuHours':state['cpuSeconds']/3600,'wallHours':output['wallSeconds']/3600,
+ 'completedPrimaryPairs':len(paired),'isolationFailure':screen,
+ 'pairChanges':[{k:p[k] for k in ['pair','changePercent']} for p in paired],
+ 'summaries':{name:v['summary'] for name,v in cases.items()}},indent=2),flush=True)
diff --git a/publish_fresh.py b/publish_fresh.py
new file mode 100644
--- /dev/null
+++ b/publish_fresh.py
@@ -0,0 +1,29 @@
+"""Guest-only bounded selection and table formatting for the stopped series."""
+from pathlib import Path
+import copy,json
+r=Path(__file__).resolve().parent
+raw=json.loads((r/'fresh-partial.json').read_text());out=copy.deepcopy(raw)
+for name,case in out['cases'].items():
+ for row in case['summary'].values():
+  row.pop('simulationCpuMs',None);row.pop('tickBusyWallMs',None)
+ quality=case['quality']
+ case['quality']={key:quality[key] for key in ['ticks','wallSeconds','ticksPerSecond',
+      'cpuReconciliationMsPerTick','client','socket','census','backgroundProcessScreen']}
+for pair in out['pairs']:
+ pair['caseNames']={arm:next(name for name,case in out['cases'].items()
+     if case['pair']==pair['pair'] and case['arm']==arm and case['qualifiedPrimary']) for arm in ['base','candidate']}
+ pair.pop('arms')
+(r/'fresh-results.json').write_text(json.dumps(out,indent=2)+'\n')
+p=raw['pairs'][0];assert len(raw['pairs'])==1
+lines=['| Tick class / metric | Base ms/tick | Candidate | Change |',
+       '| --- | ---: | ---: | ---: |']
+for phase in ['all','maintenance','ordinary']:
+ for metric,label,stats in [('gatewayCpuMs','Gateway',['mean','p50','p99']),('worldCpuMs','World',['mean','p50','p99'])]:
+  for stat in stats:
+   base=p['arms']['base']['summary'][phase][metric][stat]
+   candidate=p['arms']['candidate']['summary'][phase][metric][stat]
+   change=p['changePercent'][phase][metric][stat]
+   lines.append(f'| {phase} / {label} {stat} | {base:.6f} | {candidate:.6f} | {change:+.3f}% |')
+(r/'fresh-table.md').write_text('\n'.join(lines)+'\n')
+print(json.dumps({'publicBytes':(r/'fresh-results.json').stat().st_size,
+ 'pairs':out['completedPrimaryPairs'],'decision':out['adoption'],'failure':out['isolationFailure']},indent=2))
