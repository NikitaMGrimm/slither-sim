+"""Read-only isolation/process boundary before starting the fresh series."""
+from pathlib import Path
+import hashlib,json,os,pwd,subprocess
+r=Path(__file__).resolve().parent
+assert not Path('/tmp/slither-gateway-round3-target').exists()
+commands=subprocess.check_output(['ps','-eo','pid,ppid,stat,pcpu,args','-ww'],text=True)
+commands=commands.replace(pwd.getpwuid(os.getuid()).pw_name,'<redacted-account>')
+(r/'fresh-start-processes.txt').write_text(commands)
+foreign=[]
+for p in Path('/proc').glob('[0-9]*'):
+ try:
+  exe=(p/'exe').resolve()
+  if exe.name in ['cargo','rustc','host','slither-sim','clients']:foreign.append(int(p.name))
+ except (FileNotFoundError,PermissionError,ProcessLookupError):pass
+assert not foreign,foreign
+print(json.dumps({'taskExecutablesBeforeStart':foreign,'logicalCpus':os.cpu_count(),
+ 'processCommandsSha256':hashlib.sha256(commands.encode()).hexdigest(),'targetAbsent':True}),flush=True)
