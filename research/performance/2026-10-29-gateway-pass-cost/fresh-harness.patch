diff --git a/adoption.py b/adoption.py
new file mode 100644
--- /dev/null
+++ b/adoption.py
@@ -0,0 +1,22 @@
+"""The adoption rule frozen in 9ef4d813; no tuning from observed results."""
+import statistics
+
+def evaluate(pairs):
+ assert len(pairs)==5 and {p['pair'] for p in pairs}==set(range(5))
+ means={arm:[p['arms'][arm]['summary']['all']['gatewayCpuMs']['mean'] for p in pairs]
+        for arm in ['base','candidate']}
+ tails={arm:[p['arms'][arm]['summary']['all']['worldCpuMs']['p99'] for p in pairs]
+        for arm in ['base','candidate']}
+ paired_gateway=[100*(c/b-1) for b,c in zip(means['base'],means['candidate'])]
+ paired_tail=[100*(c/b-1) for b,c in zip(tails['base'],tails['candidate'])]
+ separation=max(means['candidate'])<min(means['base'])
+ every_gateway=all(c<b for b,c in zip(means['base'],means['candidate']))
+ every_tail=all(c<=b for b,c in zip(tails['base'],tails['candidate']))
+ return {'frozenPlanCommit':'9ef4d81377ba12eb4286a0175ecbd40416f54b52',
+  'gatewayMeanRangesMs':{arm:[min(v),max(v)] for arm,v in means.items()},
+  'gatewayRangesDoNotOverlap':separation,'everyPairedGatewayMeanImproves':every_gateway,
+  'everyPairedWorldP99DoesNotRegress':every_tail,
+  'gatewayPairedChangesPercent':paired_gateway,'worldP99PairedChangesPercent':paired_tail,
+  'gatewayMedianPairedChangePercent':statistics.median(paired_gateway),
+  'worldP99MedianPairedChangePercent':statistics.median(paired_tail),
+  'adopt':separation and every_gateway and every_tail}
diff --git a/test_adoption.py b/test_adoption.py
new file mode 100644
--- /dev/null
+++ b/test_adoption.py
@@ -0,0 +1,22 @@
+import unittest
+from adoption import evaluate
+
+def rows(base,candidate,base_tail=None,candidate_tail=None):
+ base_tail=base_tail or [8]*5;candidate_tail=candidate_tail or [7]*5
+ return [{'pair':i,'arms':{arm:{'summary':{'all':{'gatewayCpuMs':{'mean':means[i]},
+         'worldCpuMs':{'p99':tails[i]}}}} for arm,means,tails in
+         [('base',base,base_tail),('candidate',candidate,candidate_tail)]}} for i in range(5)]
+
+class AdoptionTests(unittest.TestCase):
+ def test_separated_ranges_and_equal_world_tails_qualify(self):
+  self.assertTrue(evaluate(rows([3,3.1,3.2,3.3,3.4],[2,2.1,2.2,2.3,2.4],[8]*5,[8]*5))['adopt'])
+ def test_every_paired_mean_improves_but_overlapping_ranges_reject(self):
+  result=evaluate(rows([2,2.1,2.2,2.3,2.4],[1.9,2,2.1,2.2,2.3]))
+  self.assertTrue(result['everyPairedGatewayMeanImproves']);self.assertFalse(result['adopt'])
+ def test_touching_ranges_reject(self):
+  self.assertFalse(evaluate(rows([3,3.1,3.2,3.3,3.4],[2,2.1,2.2,2.3,3]))['adopt'])
+ def test_one_tail_regression_rejects_even_with_better_median(self):
+  result=evaluate(rows([3]*5,[2]*5,[8]*5,[7,7,7,7,8.001]))
+  self.assertLess(result['worldP99MedianPairedChangePercent'],0);self.assertFalse(result['adopt'])
+
+if __name__=='__main__':unittest.main()
