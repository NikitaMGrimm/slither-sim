new file mode 100644
--- /dev/null
+++ b/check_adoption.py
@@ -0,0 +1,23 @@
+"""Check frozen policy edges and deliberate policy violations; no timing."""
+from pathlib import Path
+import json,subprocess,sys
+r=Path(__file__).resolve().parent;out=r/'adoption-controls';out.mkdir(exist_ok=False)
+source=(r/'adoption.py').read_bytes();tests=(r/'test_adoption.py').read_bytes();rows=[]
+def run(label,body,fault=False):
+ root=out/label;root.mkdir();(root/'adoption.py').write_bytes(body);(root/'test_adoption.py').write_bytes(tests)
+ result=subprocess.run([sys.executable,'-B','-m','unittest','test_adoption'],cwd=root,capture_output=True,text=True)
+ (root/'test.log').write_text(result.stdout+result.stderr,newline='\n')
+ assert (result.returncode!=0 and 'FAILED' in result.stderr) if fault else result.returncode==0
+ rows.append({'label':label,'expectedFailure':fault,'exit':result.returncode})
+run('original',source)
+for label,old,new in [
+ ('ignore-overlapping-ranges',b"separation=max(means['candidate'])<min(means['base'])",b'separation=True'),
+ ('allow-touching-ranges',b"separation=max(means['candidate'])<min(means['base'])",b"separation=max(means['candidate'])<=min(means['base'])"),
+ ('median-tail-only',b"every_tail=all(c<=b for b,c in zip(tails['base'],tails['candidate']))",b"every_tail=statistics.median(tails['candidate'])<=statistics.median(tails['base'])"),
+]:
+ assert source.count(old)==1
+ run(label,source.replace(old,new),True)
+assert (r/'adoption.py').read_bytes()==source
+run('restored',source)
+(out/'results.json').write_text(json.dumps({'passed':True,'checks':rows},indent=2)+'\n',newline='\n')
+print(json.dumps(rows))
