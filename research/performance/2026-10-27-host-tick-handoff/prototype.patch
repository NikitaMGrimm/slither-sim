@@ -0,0 +1,131 @@
+//! Experimental one-core baton. A socket pass finishes before the next tick.
+use std::sync::{
+    Condvar, Mutex, MutexGuard,
+    atomic::{AtomicBool, Ordering},
+};
+use std::time::Duration;
+
+#[derive(Clone, Copy, Default, PartialEq, Eq)]
+pub(super) enum Mode {
+    #[default]
+    Concurrent,
+    Turns,
+    Inline,
+}
+
+impl Mode {
+    pub(super) fn parse(value: Option<&str>) -> Result<Self, String> {
+        match value {
+            None | Some("concurrent") => Ok(Self::Concurrent),
+            Some("turns") => Ok(Self::Turns),
+            Some("inline") => Ok(Self::Inline),
+            _ => Err("SLITHERSIM_HOST_SCHEDULE must be concurrent, turns or inline".into()),
+        }
+    }
+}
+
+#[derive(Default)]
+pub(super) struct State {
+    tick: u64,
+    serviced: u64,
+}
+
+pub(super) struct Turns {
+    pub(super) mode: Mode,
+    state: Mutex<State>,
+    changed: Condvar,
+}
+
+impl Turns {
+    pub(super) fn new(mode: Mode) -> Self {
+        Self {
+            mode,
+            state: Mutex::new(State::default()),
+            changed: Condvar::new(),
+        }
+    }
+
+    pub(super) fn begin(&self) -> Option<MutexGuard<'_, State>> {
+        (self.mode == Mode::Turns).then(|| self.state.lock().unwrap_or_else(|e| e.into_inner()))
+    }
+
+    pub(super) fn finish(&self, guard: Option<MutexGuard<'_, State>>, stop: &AtomicBool) {
+        let Some(mut state) = guard else { return };
+        state.tick += 1;
+        self.changed.notify_all();
+        while state.serviced < state.tick && !stop.load(Ordering::Relaxed) {
+            state = self.wait(state, Duration::from_millis(100));
+        }
+    }
+
+    pub(super) fn socket_turn(
+        &self,
+        wait: Duration,
+        stop: &AtomicBool,
+    ) -> Option<MutexGuard<'_, State>> {
+        let mut state = self.state.lock().unwrap_or_else(|e| e.into_inner());
+        if state.tick == state.serviced {
+            state = self.wait(state, wait);
+        }
+        (!stop.load(Ordering::Relaxed)).then_some(state)
+    }
+
+    pub(super) fn serviced(&self, mut state: MutexGuard<'_, State>) {
+        state.serviced = state.tick;
+        self.changed.notify_all();
+    }
+
+    fn wait<'a>(&self, state: MutexGuard<'a, State>, duration: Duration) -> MutexGuard<'a, State> {
+        self.changed
+            .wait_timeout(state, duration)
+            .unwrap_or_else(|e| e.into_inner())
+            .0
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::{Arc, mpsc};
+    use std::thread;
+
+    #[test]
+    fn tick_holds_socket_pass_then_waits_for_its_acknowledgement() {
+        let turns = Arc::new(Turns::new(Mode::Turns));
+        let stop = Arc::new(AtomicBool::new(false));
+        let (entered, events) = mpsc::channel();
+        let guard = turns.begin();
+        let socket = {
+            let turns = turns.clone();
+            let stop = stop.clone();
+            thread::spawn(move || {
+                let state = turns.socket_turn(Duration::from_secs(1), &stop).unwrap();
+                entered.send(()).unwrap();
+                turns.serviced(state);
+            })
+        };
+        assert!(events.try_recv().is_err());
+        turns.finish(guard, &stop);
+        events.recv_timeout(Duration::from_secs(1)).unwrap();
+        socket.join().unwrap();
+        let state = turns.state.lock().unwrap();
+        assert_eq!(state.tick, state.serviced);
+        assert_eq!(state.tick, 1);
+    }
+
+    #[test]
+    fn stopped_host_does_not_wait_for_a_failed_socket_thread() {
+        let turns = Turns::new(Mode::Turns);
+        let stop = AtomicBool::new(true);
+        turns.finish(turns.begin(), &stop);
+        assert!(turns.socket_turn(Duration::ZERO, &stop).is_none());
+    }
+
+    #[test]
+    fn default_and_inline_need_no_baton() {
+        assert!(Turns::new(Mode::Concurrent).begin().is_none());
+        assert!(Turns::new(Mode::Inline).begin().is_none());
+        assert!(Mode::parse(Some("invalid")).is_err());
+        assert!(Mode::parse(None).unwrap() == Mode::Concurrent);
+    }
+}
