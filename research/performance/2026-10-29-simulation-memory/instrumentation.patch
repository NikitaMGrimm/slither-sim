+int md_sample_open(int event,const char *path);
+void md_drain(int maintenance){if(!ring||ring==MAP_FAILED)return;struct perf_event_mmap_page *p=ring;uint64_t head=__atomic_load_n(&p->data_head,__ATOMIC_ACQUIRE),tail=p->data_tail;char *data=(char*)ring+pagesize;size_t size=pagesize*256;while(tail<head){struct perf_event_header h;for(size_t i=0;i<sizeof(h);i++)((char*)&h)[i]=data[(tail+i)%size];if(h.size<8)abort();uint64_t record[3]={(uint64_t)maintenance,h.type,0};if(h.type==PERF_RECORD_SAMPLE){for(int i=0;i<8;i++)((char*)&record[2])[i]=data[(tail+8+i)%size];}else if(h.type==PERF_RECORD_LOST){for(int i=0;i<8;i++)((char*)&record[2])[i]=data[(tail+16+i)%size];}fwrite(record,24,1,samples);tail+=h.size;}__atomic_store_n(&p->data_tail,tail,__ATOMIC_RELEASE);}
