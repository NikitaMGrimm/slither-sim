+static uint32_t types[]={0,0,0,3,3,3,0,0};
+static uint64_t configs[]={1,0,5,0x10000,0x10002,0x10003,3,7};
+int md_open(int event){struct perf_event_attr a={0};a.size=sizeof(a);a.type=types[event];a.config=configs[event];a.disabled=1;a.exclude_kernel=1;a.exclude_hv=1;a.read_format=PERF_FORMAT_TOTAL_TIME_ENABLED|PERF_FORMAT_TOTAL_TIME_RUNNING;return syscall(__NR_perf_event_open,&a,0,-1,-1,0);}
+int md_sample_open(int event,const char *path){struct perf_event_attr a={0};a.size=sizeof(a);a.type=types[event];a.config=configs[event];a.disabled=1;a.exclude_kernel=1;a.exclude_hv=1;a.sample_period=event==1?1000003:1009;a.sample_type=PERF_SAMPLE_IP;a.read_format=PERF_FORMAT_TOTAL_TIME_ENABLED|PERF_FORMAT_TOTAL_TIME_RUNNING;a.wakeup_events=1;int fd=syscall(__NR_perf_event_open,&a,0,-1,-1,0);if(fd<0)return fd;pagesize=sysconf(_SC_PAGESIZE);ring=mmap(0,pagesize*257,PROT_READ|PROT_WRITE,MAP_SHARED,fd,0);if(ring==MAP_FAILED){close(fd);return -1;}samples=fopen(path,"wb");if(!samples)abort();return fd;}
