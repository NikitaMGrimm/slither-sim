+use std::{cell::RefCell,ffi::CString};
+unsafe extern "C" { fn md_open(event:i32)->i32; fn md_enable(fd:i32); fn md_disable(fd:i32); fn md_read(fd:i32,out:*mut u64)->i32; fn md_sample_open(event:i32,path:*const i8)->i32; fn md_drain(maintenance:i32); fn md_sample_finish(); fn close(fd:i32)->i32; }
+struct Counter{fds:[i32;2],sample:i32,rows:Vec<serde_json::Value>,start:[[u64;3];2],event:i32}
+thread_local!{static C:RefCell<Option<Counter>>=const{RefCell::new(None)};}
+fn read(fd:i32)->[u64;3]{let mut v=[0;3];assert_eq!(unsafe{md_read(fd,v.as_mut_ptr())},24);v}
+pub fn configure(event:i32,sample:bool,path:&str){C.with_borrow_mut(|c|{assert!(c.is_none());let fds=[unsafe{md_open(0)},unsafe{md_open(event)}];assert!(fds.iter().all(|&f|f>=0),"PMU open: {}",std::io::Error::last_os_error());let samplefd=if sample{let p=CString::new(format!("{path}.samples")).unwrap();let fd=unsafe{md_sample_open(event,p.as_ptr())};assert!(fd>=0,"sampling open: {}",std::io::Error::last_os_error());fd}else{-1};*c=Some(Counter{fds,sample:samplefd,rows:Vec::new(),start:[[0;3];2],event});});}
+pub fn begin(){C.with_borrow_mut(|c|{let c=c.as_mut().unwrap();for (i,&fd) in c.fds.iter().enumerate(){c.start[i]=read(fd);unsafe{md_enable(fd)}}if c.sample>=0{unsafe{md_enable(c.sample)}}});}
+pub fn end(tick:u64,maintenance:bool,ns:u64){C.with_borrow_mut(|c|{let c=c.as_mut().unwrap();for &fd in &c.fds{unsafe{md_disable(fd)}}if c.sample>=0{unsafe{md_disable(c.sample)}}let mut delta=[[0;3];2];for (i,&fd) in c.fds.iter().enumerate(){let b=read(fd);for j in 0..3{delta[i][j]=b[j]-c.start[i][j];}}if c.sample>=0{unsafe{md_drain(i32::from(maintenance))}}c.rows.push(serde_json::json!({"tick":tick,"maintenance":maintenance,"cpuNs":ns,"counters":delta}));});}
+pub fn result()->serde_json::Value{C.with_borrow(|c|{let c=c.as_ref().unwrap();serde_json::json!({"event":c.event,"rows":c.rows,"samplerCount":if c.sample>=0{Some(read(c.sample))}else{None}})})}
+pub fn finish(){C.with_borrow_mut(|c|{if let Some(c)=c.take(){for f in c.fds{unsafe{close(f)};}if c.sample>=0{unsafe{close(c.sample);md_sample_finish();}}}});}
