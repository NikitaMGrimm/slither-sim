@@ -0,0 +1,14 @@
+"""Conservative client/counter audit across full primary-window boundaries."""
+from pathlib import Path
+import json,sys,os
+r=Path(sys.argv[1]);os.sched_setaffinity(0,{3});selected=json.loads((r/'selected.json').read_text());out={}
+for name in selected['cases']:
+ p=r/'runs'/name;m=json.loads((p/'summary.json').read_text());h=m['holds'][0]
+ ss=[json.loads(x[7:]) for x in (p/'host.log').read_text().splitlines() if x.startswith('SOCKET ')]
+ cs=[json.loads(x[7:]) for x in (p/'client.log').read_text().splitlines() if x.startswith('CLIENT ')]
+ before=max((x for x in ss if x['unix']<=h['startUnix']),key=lambda x:x['unix']);after=min((x for x in ss if x['unix']>=h['endUnix']),key=lambda x:x['unix'])
+ late=max(x['lateP99Nanos'] for x in cs if h['startUnix']-1.1<=x['unix']<=h['endUnix']+1.1)/1e6
+ row={'maximumWriteBlocksEntireRun':max(x['writeBlocks'] for x in ss),'maximumBufferFullEntireRun':max(x['bufferFull'] for x in ss),'bracketedWindowWriteBlocks':after['writeBlocks']-before['writeBlocks'],'bracketedWindowBufferFull':after['bufferFull']-before['bufferFull'],'worstClientP99IncludingBoundaryReportsMs':late}
+ assert row['bracketedWindowWriteBlocks']==0 and row['bracketedWindowBufferFull']==0 and late<42
+ out[name]=row
+(r/'boundary-validity.json').write_text(json.dumps(out,indent=2)+'\n');print('FULL PRIMARY BOUNDARY AUDIT PASSED')
