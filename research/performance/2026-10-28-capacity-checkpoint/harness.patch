+"""Alternating independent mature cohorts; bounded total guest CPU allowance."""
+from pathlib import Path
+import os,subprocess,json,time,resource,signal,sys
+r=Path(__file__).resolve().parent;os.sched_setaffinity(0,{3})
+assert json.loads((r/'target-cleanup.json').read_text())['removed'] and not (r/'official-density-target').exists()
+assert json.loads((r/'preflight.json').read_text())['cases']['pilot-candidate-3']['holds'][0]['client']['keepsUp']
+prior=json.loads((r/'drift-control-cpu.json').read_text())['hostAndClientCpuSeconds']+600
+accepted=[];attempts=[];prior_accounting={'driftHostClientCpuSeconds':prior-600,'buildPilotAllowanceSeconds':600}
+def children_cpu():
+ v=resource.getrusage(resource.RUSAGE_CHILDREN);return v.ru_utime+v.ru_stime
+def active_cpu(name):
+ path=r/'runs'/name/'telemetry.jsonl'
+ if not path.exists():return 0.
+ with path.open('rb') as f:
+  f.seek(0,2);f.seek(max(0,f.tell()-65536));lines=f.read().splitlines()
+ for line in reversed(lines):
+  try:v=json.loads(line);return sum(v[k]['process']['user']+v[k]['process']['system'] for k in ['server','client'])
+  except (json.JSONDecodeError,KeyError,TypeError):pass
+ return 0.
+if '--resume-after-quiet-failure' in sys.argv:
+ attempts=json.loads((r/'cohort-attempts.json').read_text());assert len(attempts)==3 and attempts[-1]=={'name':'base-cohort-2-attempt-1','accepted':False}
+ assert 'competing process CPU' in (r/'base-cohort-2-attempt-1-selection.log').read_text()
+ accepted=[v['name'] for v in attempts if v['accepted']]
+ completed=sum(active_cpu(v['name'])+8 for v in attempts)
+ prior+=completed+20;prior_accounting.update(previousCompletedHostClientWithTailAllowanceSeconds=completed,previousControllerAllowanceSeconds=20)
+for cohort in range(1,4):
+ for arm in ['base','candidate']:
+  prefix=f'{arm}-cohort-{cohort}-attempt-'
+  if any(n.startswith(prefix) for n in accepted):continue
+  for attempt in range(1,3):
