+  with (r/('diagnostic-'+arm+'-build-controller.log')).open('x') as out:subprocess.run(['python3',str(r/'build_diagnostics.py'),arm],stdout=out,stderr=subprocess.STDOUT,check=True)
+ target=r/'official-density-target';assert target.resolve().parent==r and not target.is_symlink()
