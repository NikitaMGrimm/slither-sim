+  proc=subprocess.Popen(['python3',str(r/'run_diagnostics.py'),'base',name],stdout=out,stderr=subprocess.STDOUT)
+  while proc.poll() is None:
+   if prior+cpu()+active()>=7200:
+    proc.send_signal(signal.SIGINT);proc.wait();raise RuntimeError('diagnostic allowance exhausted; repeat retained')
