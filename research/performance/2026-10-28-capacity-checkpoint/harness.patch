diff --git a/timing.rs b/timing.rs
new file mode 100644
--- /dev/null
+++ b/timing.rs
@@ -0,0 +1,44 @@
+// Appended to the linked #248 observe.rs; archived copies only.
+use std::sync::atomic::{AtomicI32,AtomicU64,AtomicBool,Ordering};
+unsafe extern "C" {fn clock_gettime(id:i32,out:*mut CpuTime)->i32;fn pthread_self()->usize;fn pthread_getcpuclockid(thread:usize,id:*mut i32)->i32;fn ioctl(fd:i32,request:usize,...)->i32;}
+#[repr(C)]struct CpuTime{sec:i64,ns:i64}
+fn ns(id:i32)->u64{let mut t=CpuTime{sec:0,ns:0};assert_eq!(unsafe{clock_gettime(id,&mut t)},0);t.sec as u64*1_000_000_000+t.ns as u64}
+static SOCKET_CLOCK:AtomicI32=AtomicI32::new(0);
+static ACTIVE:AtomicBool=AtomicBool::new(false);
+static DIAGNOSTIC:AtomicBool=AtomicBool::new(false);
+static REJECTS:AtomicU64=AtomicU64::new(0);
+static WRITE_BLOCKS:AtomicU64=AtomicU64::new(0);
+static FULL:AtomicU64=AtomicU64::new(0);
+pub fn register_socket(){let mut id=0;assert_eq!(unsafe{pthread_getcpuclockid(pthread_self(),&mut id)},0);assert_ne!(id,0);SOCKET_CLOCK.store(id,Ordering::Relaxed);}
+pub fn active()->bool{ACTIVE.load(Ordering::Relaxed)}
+#[derive(Default)]struct ClockState{last_sim:u64,last_io:u64,phase:u64,stages:[u64;16],rows:Vec<[u64;3]>}
+thread_local!{static CLOCK:RefCell<ClockState>=RefCell::new(ClockState::default());}
+pub fn start_tick(tick:u64){
+ if tick%100==0{ACTIVE.store(std::env::var_os("CAPACITY_MEASURE").is_some_and(|p|std::path::Path::new(&p).exists()),Ordering::Relaxed);DIAGNOSTIC.store(std::env::var_os("CAPACITY_DIAGNOSTIC").is_some_and(|p|std::path::Path::new(&p).exists()),Ordering::Relaxed);}
+ if !active(){CLOCK.with_borrow_mut(|s|{s.last_sim=0;s.last_io=0;});return;}
+ CLOCK.with_borrow_mut(|s|{if s.last_sim==0{s.last_sim=ns(3);let id=SOCKET_CLOCK.load(Ordering::Relaxed);assert_ne!(id,0);s.last_io=ns(id);}});
+}
+pub fn finish_tick(wall:Instant,tick:u64){
+ if !active(){return;}
+ let sim=ns(3);let io=ns(SOCKET_CLOCK.load(Ordering::Relaxed));
+ CLOCK.with_borrow_mut(|s|{
+  s.rows.push([sim-s.last_sim,io-s.last_io,wall.elapsed().as_nanos() as u64]);s.last_sim=sim;s.last_io=io;
+  if tick%100==0{
+   eprintln!("CAPACITY {}",serde_json::json!({"unix":std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs_f64(),"tick":tick,"rows":s.rows,"stages":s.stages}));s.rows.clear();s.stages=[0;16];
+  }
+ });
+}
+pub struct CpuGuard{stage:usize,start:u64}
+impl CpuGuard{pub fn new(stage:usize)->Self{Self{stage,start:if active()&&(stage<10||DIAGNOSTIC.load(Ordering::Relaxed)){ns(3)}else{0}}}}
+impl Drop for CpuGuard{fn drop(&mut self){if self.start!=0{let elapsed=ns(3)-self.start;CLOCK.with_borrow_mut(|s|s.stages[self.stage]+=elapsed);}}}
+pub fn begin_world(){if active(){let at=ns(3);CLOCK.with_borrow_mut(|s|s.phase=at);}}
+pub fn mark(stage:usize){if active(){let at=ns(3);CLOCK.with_borrow_mut(|s|{s.stages[stage]+=at-s.phase;s.phase=at;});}}
+pub fn reject(){REJECTS.fetch_add(1,Ordering::Relaxed);}
+pub fn write_result<T>(result:&std::io::Result<T>){if result.as_ref().is_err_and(|e|e.kind()==std::io::ErrorKind::WouldBlock){WRITE_BLOCKS.fetch_add(1,Ordering::Relaxed);}}
+pub fn full(){FULL.fetch_add(1,Ordering::Relaxed);}
+pub fn outq(fd:i32)->u64{let mut bytes:i32=0;assert_eq!(unsafe{ioctl(fd,0x5411usize,&mut bytes)},0);bytes.max(0) as u64}
+pub fn socket_report(queue:u64,kernel:u64,players:usize){
+ static LAST:std::sync::Mutex<Option<Instant>>=std::sync::Mutex::new(None);
+ let mut last=LAST.lock().unwrap();if last.is_some_and(|t|t.elapsed().as_secs_f64()<1.){return;}*last=Some(Instant::now());
+ CLOCK.with_borrow_mut(|s|{eprintln!("SOCKET {}",serde_json::json!({"unix":std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs_f64(),"active":active(),"queueBytes":queue,"kernelSendBytes":kernel,"players":players,"rejects":REJECTS.load(Ordering::Relaxed),"writeBlocks":WRITE_BLOCKS.load(Ordering::Relaxed),"bufferFull":FULL.load(Ordering::Relaxed),"stages":s.stages}));s.stages=[0;16];});
+}
