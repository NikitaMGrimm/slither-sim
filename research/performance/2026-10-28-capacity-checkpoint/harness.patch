+++ b/client.rs
@@ -0,0 +1,92 @@
+//! Research-only 500-socket received-frame load; no authoritative observations.
+use slither_sim::{Action, client::{Bot, ClientState, ClientStatus, ForagerBot, network::login_packet, protocol::action_packets}};
+use std::{net::TcpStream,io,thread,time::{Instant,Duration},path::PathBuf,os::fd::AsRawFd};
+use tungstenite::{WebSocket,Message,client::IntoClientRequest};
+unsafe extern "C" {fn sched_setaffinity(pid:i32,size:usize,mask:*const u64)->i32;fn clock_gettime(id:i32,t:*mut Ts)->i32;fn poll(fds:*mut PollFd,n:u64,timeout:i32)->i32;}
+#[repr(C)]struct Ts{i:i64,n:i64}
+#[repr(C)]struct PollFd{fd:i32,events:i16,revents:i16}
+fn cpu()->u64{let mut t=Ts{i:0,n:0};assert_eq!(unsafe{clock_gettime(3,&mut t)},0);t.i as u64*1_000_000_000+t.n as u64}
+fn pin(core:usize){let mut bits=[0u64;16];bits[core/64]|=1<<(core%64);assert_eq!(unsafe{sched_setaffinity(0,128,bits.as_ptr())},0);}
+struct Seat{id:usize,socket:WebSocket<TcpStream>,state:ClientState,boost:Option<bool>,due:f64,last_read:f64,frames:u64,bytes:u64,blocked:bool,pending:Option<f64>}
+impl Seat{
+ fn connect(id:usize,epoch:Instant,port:u16)->Result<Self,String>{
+  let tcp=TcpStream::connect((std::net::Ipv4Addr::LOCALHOST,port)).map_err(|e|e.to_string())?;
+  tcp.set_nodelay(true).unwrap();tcp.set_read_timeout(Some(Duration::from_secs(3))).unwrap();tcp.set_write_timeout(Some(Duration::from_secs(3))).unwrap();
+  let mut req=format!("ws://127.0.0.1:{port}/slither").into_client_request().unwrap();req.headers_mut().insert("x-slithersim-food","physical".parse().unwrap());
+  let (mut socket,_)=tungstenite::client(req,tcp).map_err(|e|e.to_string())?;
+  socket.send(Message::Binary(login_packet(&format!("Local{id}"),(id%65) as u8)?.into())).map_err(|e|e.to_string())?;
+  socket.get_mut().set_nonblocking(true).unwrap();
+  let at=epoch.elapsed().as_secs_f64();let mut state=ClientState::new();state.new_connection(at)?;
+  Ok(Self{id,socket,state,boost:None,due:at+0.042*(id%16) as f64/16.,last_read:at,frames:0,bytes:0,blocked:false,pending:None})
+ }
+ fn close_clean(&mut self,epoch:Instant)->Result<(u64,u64),String>{
+  self.socket.close(None).map_err(|e|e.to_string())?;
+  let start=Instant::now();let mut frames=0;let mut bytes=0;
+  while start.elapsed()<Duration::from_millis(200){
+   match self.socket.read(){
+    Ok(Message::Close(_))|Err(tungstenite::Error::ConnectionClosed)=>return Ok((frames,bytes)),
+    Ok(Message::Binary(data))=>{self.state.receive_frame(&data,epoch.elapsed().as_secs_f64())?;frames+=1;bytes+=data.len() as u64;},
+    Ok(_)=>{},
+    Err(tungstenite::Error::Io(e)) if e.kind()==io::ErrorKind::WouldBlock=>thread::sleep(Duration::from_micros(50)),
+    Err(e)=>return Err(format!("close handshake: {e}")),
+   }
+  }
+  Err("close handshake timeout".into())
+ }
+ fn send(&mut self,packet:Vec<u8>,at:f64)->Result<(),String>{
+  self.state.record_sent(&packet,at)?;
+  match self.socket.write(Message::Binary(packet.into())){Ok(())=>Ok(()),Err(e)=>Err(format!("client write: {e}"))}
+ }
+}
+fn worker(core:usize,count:usize,port:u16,root:PathBuf,epoch:Instant)->Result<(),String>{
+ pin(core);let mut policy=ForagerBot::new();let mut seats=Vec::new();
+ for id in (core-1..count).step_by(3){seats.push(Seat::connect(id,epoch,port)?);thread::sleep(Duration::from_millis(3));}
+ let mut due_count=0u64;let mut decisions=0u64;let mut joins=seats.len() as u64;let mut forced=0u64;let mut deaths=0u64;let mut refused=0u64;let mut frames=0u64;let mut bytes=0u64;let mut lates=Vec::<u64>::new();let mut report=Instant::now();let mut prior_cpu=cpu();let mut prior_wall=Instant::now();let mut max_pass=0u64;let mut previous_churn=0u64;
+ while !root.join("STOP").exists(){
+  let pass=Instant::now();let thin=root.join("THIN").exists();
+  let tick=std::fs::read_to_string(root.join("tick")).ok().and_then(|x|x.trim().parse::<u64>().ok()).unwrap_or(0);
+  let churn=(tick.min(179999))/50;
+  let mut ready:Vec<_>=seats.iter().map(|s|PollFd{fd:if s.pending.is_some(){-1}else{s.socket.get_ref().as_raw_fd()},events:1,revents:0}).collect();
+  assert!(unsafe{poll(ready.as_mut_ptr(),ready.len() as u64,0)}>=0);
+  for (index,s) in seats.iter_mut().enumerate(){
+   if let Some(at)=s.pending{if epoch.elapsed().as_secs_f64()>=at{*s=Seat::connect(s.id,epoch,port)?;joins+=1;}continue;}
+   let retire=s.id>=100 && (previous_churn+1..=churn).any(|n|100+((n-1)%400) as usize==s.id);
+   let mut dead=false;
+   if ready[index].revents!=0||!s.blocked{s.blocked=false;for _ in 0..256{
+    match s.socket.read(){
+     Ok(Message::Binary(data))=>{let at=epoch.elapsed().as_secs_f64();s.state.receive_frame(&data,at)?;s.last_read=at;s.frames+=1;s.bytes+=data.len() as u64;frames+=1;bytes+=data.len() as u64;},
+     Ok(Message::Close(reason))=>{if s.state.status()==ClientStatus::Waiting && reason.as_ref().is_some_and(|r|r.reason.as_str()=="Server is full"){refused+=1;s.pending=Some(epoch.elapsed().as_secs_f64()+0.042);break;}else{return Err(format!("unexpected server close: {reason:?}"));}},
+     Ok(_)=>{},
+     Err(tungstenite::Error::Io(e)) if e.kind()==io::ErrorKind::WouldBlock=>{s.blocked=true;break;},
+     Err(e)=>return Err(format!("client read: {e}")),
+    }
+   }}
+   if s.pending.is_some(){continue;}
+   let at=epoch.elapsed().as_secs_f64();
+   if at>=s.due{
+    due_count+=1;lates.push(((at-s.due)*1e9) as u64);s.due=(s.due+0.042).max(at+0.000001);
+    dead=s.state.status()==ClientStatus::Dead;
+    if !dead && !retire && s.state.status()==ClientStatus::Playing{
+     let frame=s.state.frame(at)?;
+     let action=if thin{frame.observation.as_ref().map(|o|Action{heading:o.me.heading+0.01,boost:false})}else{policy.decide(&frame)};
+     if let Some(action)=action{for packet in action_packets(action,s.boost)?{s.send(packet,at)?;}s.boost=Some(action.boost);decisions+=1;}
+    }
+   }
+   if dead||retire{
+    if retire{forced+=1;}else{deaths+=1;}
+    let(f,b)=s.close_clean(epoch)?;frames+=f;bytes+=b;s.state.disconnect();s.pending=Some(epoch.elapsed().as_secs_f64()+0.028);continue;
+   }
+   if s.state.ping_due(at)?{s.send(vec![251],at)?;}
+   s.socket.flush().map_err(|e|format!("client flush: {e}"))?;
+  }
+  previous_churn=churn;max_pass=max_pass.max(pass.elapsed().as_nanos() as u64);
+  if report.elapsed()>=Duration::from_secs(1){
+   let now=cpu();let seconds=prior_wall.elapsed().as_secs_f64();lates.sort_unstable();let q=|p:f64|lates.get(((lates.len().saturating_sub(1)) as f64*p).ceil() as usize).copied().unwrap_or(0);
+   eprintln!("CLIENT {}",serde_json::json!({"unix":std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs_f64(),"worker":core,"thin":thin,"cpuFraction":(now-prior_cpu) as f64/1e9/seconds,"seats":seats.len(),"playing":seats.iter().filter(|s|s.state.status()==ClientStatus::Playing).count(),"frames":frames,"bytes":bytes,"decisions":decisions,"due":due_count,"joins":joins,"forced":forced,"deaths":deaths,"admissionRefusals":refused,"maxPassNanos":max_pass,"lateP99Nanos":q(0.99),"lateMaxNanos":q(1.),"maxReceiptAge":seats.iter().filter(|s|s.pending.is_none()).map(|s|epoch.elapsed().as_secs_f64()-s.last_read).fold(0.,f64::max)}));
+   prior_cpu=now;prior_wall=Instant::now();report=Instant::now();max_pass=0;lates.clear();
+  }
+  thread::sleep(Duration::from_micros(200));
+ }
+ Ok(())
+}
+fn main(){let a:Vec<_>=std::env::args().collect();let root=PathBuf::from(&a[1]);let port=a[2].parse().unwrap();let count=a[3].parse().unwrap();let epoch=Instant::now();pin(3);let workers:Vec<_>=(1..=3).map(|core|{let root=root.clone();thread::Builder::new().name(format!("capacity-bot-{core}")).spawn(move||worker(core,count,port,root,epoch).unwrap()).unwrap()}).collect();for w in workers{w.join().unwrap();}}
