@@ -0,0 +1,28 @@
+"""User-only instruction/cycle group on one existing simulation thread."""
+from pathlib import Path
+import ctypes,os,struct,time,json,sys,fcntl,subprocess,pwd,hashlib
+r=Path(sys.argv[1]);pid=int(sys.argv[2]);seconds=float(sys.argv[3])
+os.sched_setaffinity(0,{3});lib=ctypes.CDLL(None,use_errno=True);lib.syscall.restype=ctypes.c_long
+tid=next(int(t.name) for t in Path(f'/proc/{pid}/task').iterdir() if (t/'comm').read_text().startswith('slither-simulat'))
+fds=[]
+def inventory(label):
+ raw=subprocess.check_output(['ps','-eo','pid,ppid,stat,pcpu,args','-ww'],text=True).replace(pwd.getpwuid(os.getuid()).pw_name,'<redacted-account>')
+ (r/('perf-'+label+'-processes.txt')).write_text(raw)
+ return hashlib.sha256(raw.encode()).hexdigest()
+try:
+ for config in [1,0]:
+  a=(ctypes.c_uint64*16)();a[0]=128<<32;a[1]=config;a[4]=3;a[5]=(1<<5)|(1<<6)|(1 if not fds else 0)
+  fd=lib.syscall(298,ctypes.byref(a),ctypes.c_int(tid),ctypes.c_int(-1),ctypes.c_int(fds[0] if fds else -1),ctypes.c_ulong(0))
+  if fd<0:raise OSError(ctypes.get_errno(),'user perf group unavailable')
+  fds.append(fd)
+ def read():return [struct.unpack('QQQ',os.read(fd,24)) for fd in fds]
+ def stat():
+  f=Path(f'/proc/{pid}/task/{tid}/stat').read_text().rsplit(')',1)[1].split();hz=os.sysconf('SC_CLK_TCK');return {'userSeconds':int(f[11])/hz,'kernelSeconds':int(f[12])/hz}
+ inventory0=inventory('start');before=read();cpu0=stat();start=time.time();fcntl.ioctl(fds[0],0x2400,1)
+ time.sleep(seconds)
+ fcntl.ioctl(fds[0],0x2401,1);end=time.time();after=read();cpu1=stat()
+ d=[[y-x for x,y in zip(a,b)] for a,b in zip(before,after)];assert all(v[1]>0 and v[2]/v[1]>.99 for v in d),d
+ inventory1=inventory('end')
+ (r/'perf-window.json').write_text(json.dumps({'startUnix':start,'endUnix':end,'instructionsUser':d[0][0],'cyclesUser':d[1][0],'IPC':d[0][0]/d[1][0],'events':[{'event':name,'enabledNanos':v[1],'runningNanos':v[2]} for name,v in zip(['instructions:u','cycles:u'],d)],'threadCpuSeconds':{k:cpu1[k]-cpu0[k] for k in cpu0},'processListStartSha256':inventory0,'processListEndSha256':inventory1},indent=2)+'\n')
+finally:
+ for fd in fds:os.close(fd)
