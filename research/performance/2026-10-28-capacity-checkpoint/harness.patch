+"""Read-only host-vCPU context, separate from the task CPU-accounting view."""
+from pathlib import Path
+import os,time,json
+r=Path(__file__).resolve().parent;os.sched_setaffinity(0,{3});start=time.monotonic();hz=os.sysconf('SC_CLK_TCK')
+with (r/'core-telemetry.jsonl').open('a') as out:
+ while not (r/'CORE_STOP').exists() and time.monotonic()-start<8*3600:
+  values=next(x.split()[1:] for x in Path('/proc/stat').read_text().splitlines() if x.startswith('cpu0 '))
+  processes=[]
+  for task in Path('/proc').iterdir():
+   if not task.name.isdigit():continue
+   try:
+    fields=(task/'stat').read_text().rsplit(')',1)[1].split()
+    command=(task/'cmdline').read_bytes()
+    processes.append({'pid':int(task.name),'start':fields[19],'cpu':(int(fields[11])+int(fields[12]))/hz,'kernel':bool(int(fields[6])&0x200000),'study':str(r).encode() in command})
+   except (FileNotFoundError,ProcessLookupError,PermissionError):pass
+  out.write(json.dumps({'unix':time.time(),'seconds':{k:int(v)/hz for k,v in zip(['user','nice','system','idle','iowait','irq','softirq','steal','guest','guestNice'],values)},'processes':processes})+'\n');out.flush();time.sleep(1)
