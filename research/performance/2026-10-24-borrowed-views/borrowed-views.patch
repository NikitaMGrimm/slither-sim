+    /// Checks every view of `sighted` against the owned observations of the same
+    /// slots: each list item by item, then the whole observation.
+    fn check_sighted(sighted: super::Sighted, expected: &[Option<Observation>], case: usize) {
+        assert_eq!(sighted.len(), expected.len(), "case {case}");
+        assert_eq!(sighted.iter().len(), expected.len(), "case {case}");
+        assert!(sighted.get(expected.len()).is_none(), "case {case}");
+        for (slot, (view, expected)) in sighted.iter().zip(expected).enumerate() {
+            let (Some(view), Some(o)) = (view, expected) else {
+                assert_eq!(
+                    view.is_some(),
+                    expected.is_some(),
+                    "case {case} slot {slot}"
+                );
+                continue;
+            };
+            let list = |items: Vec<&dyn std::fmt::Debug>| format!("{items:?}");
+            assert_eq!(view.slot(), slot);
+            assert_eq!(format!("{:?}", view.me()), format!("{:?}", o.me));
+            assert_eq!(view.opponents().len(), o.opponents.len(), "case {case}");
+            assert_eq!(view.food().len(), o.food.len(), "case {case}");
+            assert_eq!(view.prey().len(), o.prey.len(), "case {case}");
+            assert_eq!(
+                list(view.opponents().map(|s| s as _).collect()),
+                list(o.opponents.iter().map(|s| s as _).collect()),
+                "case {case} slot {slot}"
+            );
+            assert_eq!(
+                list(view.food().map(|f| f as _).collect()),
+                list(o.food.iter().map(|f| f as _).collect()),
+                "case {case} slot {slot}"
+            );
+            assert_eq!(
+                list(view.prey().map(|p| p as _).collect()),
+                list(o.prey.iter().map(|p| p as _).collect()),
+                "case {case} slot {slot}"
+            );
+            assert_eq!(
+                format!("{:?}", view.to_observation()),
+                format!("{o:?}"),
+                "case {case} slot {slot}"
+            );
+        }
+    }
