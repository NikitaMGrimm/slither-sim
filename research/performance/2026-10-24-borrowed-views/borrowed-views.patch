+/// Reusable storage for [`Simulator::sight_all`] and
+/// [`Simulator::sight_selected`]: what each slot sees, as indices into world
+/// state, and scratch space for the visibility index. Its contents are reachable
+/// only through the [`Sighted`] those calls return.
+#[derive(Debug, Default)]
+pub struct Sightings {
+    pub(crate) slots: Vec<Option<Sighting>>,
+    marks: Vec<u64>,
+}
+
+/// What every slot of one world sees, borrowed from that world and a
+/// [`Sightings`] buffer. Only [`Simulator::sight_all`] and
+/// [`Simulator::sight_selected`] create it, so its indices always refer to the
+/// world it borrows.
+#[derive(Clone, Copy)]
+pub struct Sighted<'a> {
+    world: VisibleState<'a>,
+    slots: &'a [Option<Sighting>],
+}
+impl<'a> Sighted<'a> {
+    /// The view of `slot`; `None` for dead, unselected and unknown slots.
+    pub fn get(&self, slot: usize) -> Option<ObservationRef<'a>> {
+        let sighting = self.slots.get(slot)?.as_ref()?;
+        Some(ObservationRef {
+            world: self.world,
+            slot,
+            sighting,
+        })
+    }
+    /// Slots in the world, including dead and unselected ones.
+    pub fn len(&self) -> usize {
+        self.slots.len()
+    }
+    pub fn is_empty(&self) -> bool {
+        self.slots.is_empty()
+    }
+    /// [`get`](Self::get) for every slot in order.
+    pub fn iter(&self) -> impl ExactSizeIterator<Item = Option<ObservationRef<'a>>> + use<'a> {
+        let this = *self;
+        (0..this.len()).map(move |slot| this.get(slot))
+    }
+}
+
+/// One slot's view, borrowed from the world: the data of
+/// [`Simulator::observe`] at full precision, without copying it.
+#[derive(Clone, Copy)]
+pub struct ObservationRef<'a> {
+    world: VisibleState<'a>,
+    slot: usize,
+    sighting: &'a Sighting,
+}
+impl<'a> ObservationRef<'a> {
+    pub fn slot(&self) -> usize {
+        self.slot
+    }
+    pub fn me(&self) -> &'a Snake {
+        &self.world.snakes[self.slot]
+    }
+    /// Visible opponents in slot order, as in [`Observation::opponents`].
+    pub fn opponents(&self) -> Refs<'a, Snake> {
+        Refs::new(self.world.snakes, &self.sighting.opponents)
+    }
+    /// Visible food in world order, as in [`Observation::food`].
+    pub fn food(&self) -> Refs<'a, Food> {
+        Refs::new(self.world.food, &self.sighting.food)
+    }
+    /// Visible prey in world order, as in [`Observation::prey`].
+    pub fn prey(&self) -> Refs<'a, Prey> {
+        Refs::new(self.world.prey, &self.sighting.prey)
+    }
+    pub fn time(&self) -> f64 {
+        self.world.time
+    }
+    pub fn arena(&self) -> Arena {
+        self.world.arena()
+    }
+    /// Always known for world views; [`Observation::vision_radius`] is optional
+    /// only because received frames may lack it.
+    pub fn vision_radius(&self) -> f64 {
+        self.world.vision
+    }
+    /// The owned observation, equal to [`Simulator::observe`] of this slot.
+    pub fn to_observation(&self) -> Observation {
+        Observation {
+            time: self.time(),
+            me: self.me().clone(),
+            opponents: self.opponents().cloned().collect(),
+            food: self.food().cloned().collect(),
+            prey: self.prey().cloned().collect(),
+            arena: self.arena(),
+            vision_radius: Some(self.vision_radius()),
+        }
+    }
+}
+
+/// References to the world items an [`ObservationRef`] lists, in its order.
+pub struct Refs<'a, T> {
+    items: &'a [T],
+    indices: std::slice::Iter<'a, usize>,
+}
+// Derived `Clone` would require `T: Clone`; cloning only copies references.
+impl<T> Clone for Refs<'_, T> {
+    fn clone(&self) -> Self {
+        Self {
+            items: self.items,
+            indices: self.indices.clone(),
+        }
+    }
+}
+impl<'a, T> Refs<'a, T> {
+    fn new(items: &'a [T], indices: &'a [usize]) -> Self {
+        Self {
+            items,
+            indices: indices.iter(),
+        }
+    }
+}
+impl<'a, T> Iterator for Refs<'a, T> {
+    type Item = &'a T;
+    fn next(&mut self) -> Option<&'a T> {
+        self.indices.next().map(|&i| &self.items[i])
+    }
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        self.indices.size_hint()
+    }
+}
+impl<T> DoubleEndedIterator for Refs<'_, T> {
+    fn next_back(&mut self) -> Option<Self::Item> {
+        self.indices.next_back().map(|&i| &self.items[i])
+    }
+}
+impl<T> ExactSizeIterator for Refs<'_, T> {}
+impl<T> std::iter::FusedIterator for Refs<'_, T> {}
