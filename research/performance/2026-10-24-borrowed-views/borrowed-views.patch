+    #[test]
+    fn sightings_match_observations() {
+        let mut rng = Rng(0x0bad_5eed_1234_5678);
+        let visions = [
+            1500.0,
+            300.0,
+            0.0,
+            1e-9,
+            1e5,
+            1e13,
+            f64::INFINITY,
+            f64::NAN,
+            -1.0,
+        ];
+        // Reused across worlds of every shape and slot count.
+        let mut buffer = super::Sightings::default();
+        for case in 0..400 {
+            let vision = visions[case % visions.len()];
+            let snakes = [0, 1, 2, 5, 9, 30, 60][rng.below(7)];
+            let food = [0, 1, 256, 700, 3000][rng.below(5)];
+            let world = world(&mut rng, snakes, food, vision);
+            let single: Vec<_> = (0..snakes)
+                .map(|i| world.snakes[i].alive.then(|| world.observe(i).unwrap()))
+                .collect();
+            check_sighted(world.sight_all(&mut buffer), &single, case);
+            let mask: Vec<bool> = (0..snakes).map(|_| rng.below(3) != 0).collect();
+            let selected: Vec<_> = single
+                .iter()
+                .zip(&mask)
+                .map(|(o, &m)| o.clone().filter(|_| m))
+                .collect();
+            let before = format!("{:?}", buffer.slots);
+            assert_eq!(
+                world
+                    .sight_selected(&[true; 61], &mut buffer)
+                    .err()
+                    .as_deref(),
+                Some("One selection flag per agent slot required")
+            );
+            assert_eq!(format!("{:?}", buffer.slots), before, "case {case}");
+            check_sighted(
+                world.sight_selected(&mask, &mut buffer).unwrap(),
+                &selected,
+                case,
+            );
+            let none = vec![false; snakes];
+            check_sighted(
+                world.sight_selected(&none, &mut buffer).unwrap(),
+                &vec![None; snakes],
+                case,
+            );
+        }
+    }
