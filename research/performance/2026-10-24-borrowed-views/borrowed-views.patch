diff --git a/tests/observation_ref.rs b/tests/observation_ref.rs
new file mode 100644
index 0000000..66e26bf
--- /dev/null
+++ b/tests/observation_ref.rs
@@ -0,0 +1,175 @@
+//! Borrowed observations against the owned observations of the same worlds.
+use slither_sim::*;
+
+/// A crowded synthetic world: `snakes` on a ring 1,000 units out, inside a
+/// 2,000-unit arena with prey, so every slot sees many opponents.
+fn crowded(seed: u32, snakes: usize) -> Simulator {
+    let mut world = Simulator::new(
+        seed,
+        Config {
+            radius: 2000.0,
+            dynamic_radius: false,
+            prey: PreyConfig {
+                count: 40,
+                ..PreyConfig::default()
+            },
+            ..Config::official(snakes)
+        },
+    )
+    .unwrap();
+    for i in 0..snakes {
+        world.add(format!("s{i}"), i, snakes).unwrap();
+    }
+    world
+}
+
+/// Living snakes head for the center, slightly off line, and some boost, so
+/// they cross each other's bodies and die.
+fn actions(world: &Simulator, tick: usize) -> Vec<Option<Action>> {
+    world
+        .snakes
+        .iter()
+        .enumerate()
+        .map(|(i, s)| {
+            s.alive.then(|| Action {
+                heading: (-s.head.y).atan2(-s.head.x) + 0.3 * ((i + tick / 40) as f64).sin(),
+                boost: (i + tick / 25) % 4 == 0,
+            })
+        })
+        .collect()
+}
+
+#[derive(Default)]
+struct Seen {
+    views: usize,
+    dead: usize,
+    opponents: usize,
+    prey: usize,
+}
+
+/// Checks every slot of `sighted` against `observe(slot)`, list by list and as a
+/// whole, and against the batch observation of the same selection.
+fn check(world: &Simulator, sighted: Sighted, selected: Option<&[bool]>, seen: &mut Seen) {
+    let batch = match selected {
+        Some(mask) => world.observe_selected(mask).unwrap(),
+        None => world.observe_all(),
+    };
+    assert_eq!(sighted.len(), world.snakes.len());
+    assert_eq!(sighted.iter().len(), world.snakes.len());
+    assert!(sighted.get(world.snakes.len()).is_none());
+    for (slot, view) in sighted.iter().enumerate() {
+        let wanted = world.snakes[slot].alive && selected.is_none_or(|mask| mask[slot]);
+        assert_eq!(view.is_some(), wanted, "slot {slot}");
+        assert_eq!(sighted.get(slot).is_some(), wanted, "slot {slot}");
+        let Some(view) = view else {
+            seen.dead += usize::from(!world.snakes[slot].alive);
+            continue;
+        };
+        let owned = world.observe(slot).unwrap();
+        assert_eq!(view.slot(), slot);
+        assert!(std::ptr::eq(view.me(), &world.snakes[slot]));
+        assert_eq!(view.me(), &owned.me);
+        assert_eq!(view.opponents().len(), owned.opponents.len());
+        assert!(view.opponents().eq(&owned.opponents));
+        assert_eq!(view.food().len(), owned.food.len());
+        assert!(view.food().eq(&owned.food));
+        assert_eq!(view.prey().len(), owned.prey.len());
+        assert!(view.prey().eq(&owned.prey));
+        assert!(view.opponents().rev().eq(owned.opponents.iter().rev()));
+        assert_eq!(view.time(), owned.time);
+        assert_eq!(view.arena(), owned.arena);
+        assert_eq!(Some(view.vision_radius()), owned.vision_radius);
+        assert_eq!(view.to_observation(), owned);
+        assert_eq!(batch[slot].as_ref(), Some(&owned));
+        seen.views += 1;
+        seen.opponents += owned.opponents.len();
+        seen.prey += owned.prey.len();
+    }
+}
+
+/// Steps a crowded world, checking full and selected sightings through one
+/// buffer every few ticks until most snakes have died.
+fn run(world: &mut Simulator, buffer: &mut Sightings, seen: &mut Seen) {
+    for tick in 0..600 {
+        if tick % 15 == 0 {
+            check(world, world.sight_all(buffer), None, seen);
+            let mask: Vec<bool> = (0..world.snakes.len())
+                .map(|i| (i + tick) % 3 != 0)
+                .collect();
+            check(
+                world,
+                world.sight_selected(&mask, buffer).unwrap(),
+                Some(&mask),
+                seen,
+            );
+        }
+        if world.living() < 4 {
+            break;
+        }
+        world.step(&actions(world, tick)).unwrap();
+    }
+}
+
+#[test]
+fn sightings_match_observations_through_deaths() {
+    let mut buffer = Sightings::default();
+    let mut seen = Seen::default();
+    let mut world = crowded(3, 96);
+    run(&mut world, &mut buffer, &mut seen);
+    assert!(seen.dead > 0, "no deaths were observed");
+    assert!(seen.views > 1000 && seen.opponents > 10 * seen.views);
+    assert!(seen.prey > 0, "no prey were observed");
+}
+
+#[test]
+fn one_buffer_serves_worlds_of_every_size() {
+    let mut buffer = Sightings::default();
+    let mut seen = Seen::default();
+    let empty = Simulator::new(1, Config::official(1)).unwrap();
+    assert!(empty.sight_all(&mut buffer).is_empty());
+    for (seed, snakes) in [(1, 64), (2, 3), (3, 0), (4, 128), (5, 1), (6, 40)] {
+        let mut world = crowded(seed, snakes);
+        run(&mut world, &mut buffer, &mut seen);
+        check(&world, world.sight_all(&mut buffer), None, &mut seen);
+    }
+    assert!(seen.dead > 0 && seen.prey > 0);
+}
+
+#[test]
+fn selection_masks_are_validated_like_observe_selected() {
+    let world = crowded(9, 12);
+    let mut buffer = Sightings::default();
+    for mask in [vec![true; 11], vec![true; 13], Vec::new()] {
+        let expected = world.observe_selected(&mask).unwrap_err();
+        assert_eq!(expected, "One selection flag per agent slot required");
+        assert_eq!(
+            world.sight_selected(&mask, &mut buffer).err(),
+            Some(expected)
+        );
+    }
+    let mut seen = Seen::default();
+    let none = vec![false; 12];
+    check(
+        &world,
+        world.sight_selected(&none, &mut buffer).unwrap(),
+        Some(&none),
+        &mut seen,
+    );
+    assert_eq!(seen.views, 0);
+}
+
+#[cfg(feature = "parallel")]
+#[test]
+fn parallel_sightings_match_sequential_observations() {
+    let pool = rayon::ThreadPoolBuilder::new()
+        .num_threads(4)
+        .build()
+        .unwrap();
+    let mut buffer = Sightings::default();
+    let mut seen = Seen::default();
+    // `check` compares against single-slot observations, which never split.
+    let mut world = crowded(5, 128);
+    world.set_parallel(true);
+    pool.install(|| run(&mut world, &mut buffer, &mut seen));
+    assert!(seen.dead > 0 && seen.views > 1000);
+}
