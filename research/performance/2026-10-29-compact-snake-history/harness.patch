+use std::cell::RefCell;
+unsafe extern "C" { fn pmu_open(mode:i32)->i32;fn pmu_read(out:*mut u64)->i32;fn pmu_close(); }
+struct Counter{mode:i32,rows:Vec<[u64;9]>,total:[u64;6]}
+thread_local!{static C:RefCell<Option<Counter>>=const{RefCell::new(None)};}
+pub fn configure(mode:i32){let result=unsafe{pmu_open(mode)};assert_eq!(result,0,"PMU group open errno {}",-result);C.with_borrow_mut(|c|{assert!(c.is_none());*c=Some(Counter{mode,rows:Vec::new(),total:[0;6]});});}
+pub fn read()->[u64;6]{let mut out=[0;6];assert_eq!(unsafe{pmu_read(out.as_mut_ptr())},0);out}
+pub fn record(start:[u64;6],end:[u64;6],tick:u64,maintenance:bool,ns:u64){let delta=std::array::from_fn::<_,6,_>(|i|end[i]-start[i]);assert!(delta[0]>0 && delta[1] as f64/delta[0] as f64>=0.99,"PMU group multiplexed");C.with_borrow_mut(|c|{let c=c.as_mut().unwrap();for(i,v)in delta.iter().enumerate(){c.total[i]+=v;}c.rows.push([tick,u64::from(maintenance),ns,delta[2],delta[3],delta[4],delta[5],delta[0],delta[1]]);});}
+pub fn result()->serde_json::Value{C.with_borrow(|c|{let c=c.as_ref().unwrap();let mut ins=[0u64;16];let mut calls=[0u64;16];ins[2]=c.total[2];calls[2]=c.rows.len() as u64;serde_json::json!({"instructions":ins,"calls":calls,"pmuMode":c.mode,"rows":c.rows,"total":c.total,"rowColumns":["tick","maintenance","cpuNs","instructions","cycles","L1d","dTLB","enabledNs","runningNs"]})})}
+pub fn finish(){unsafe{pmu_close()};C.with_borrow_mut(|c|*c=None);}
