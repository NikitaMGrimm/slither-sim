+ results.append({'name':name,'seats':ready['seats'],'requestedWarmTicks':ready['warmTicks'],'start':ready['ready']['base']['summary']['census'],'startTick':ready['ready']['base']['summary']['tick'],'end':summaries['base']['census'],'endTick':summaries['base']['tick'],'storage':storage,'pairs':pairs,'summary':summary,'proofs':{'warmBytes':ready['traceBytes'],'warmSha256':ready['traceSha256'],'completeWarmStreamsEqual':True,'allSixContinuationStreamsEqual':True,'completeContinuationSha256':accepted['receipts'][0]['completeTraceSha256'],'wirePayloadSha256':accepted['receipts'][0]['wirePayloadSha256'],'terminalRecordsValidated':all(x['terminalValidated'] for x in accepted['receipts'])}})
