+#define _GNU_SOURCE
+#include <linux/perf_event.h>
+#include <sys/syscall.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+#include <stdint.h>
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+static int fds[4]={-1,-1,-1,-1}, count;
+static uint64_t ids[4];
+static int indices[4];
+static const uint32_t types[4]={PERF_TYPE_HARDWARE,PERF_TYPE_HARDWARE,PERF_TYPE_HW_CACHE,PERF_TYPE_HW_CACHE};
+static const uint64_t configs[4]={PERF_COUNT_HW_INSTRUCTIONS,PERF_COUNT_HW_CPU_CYCLES,PERF_COUNT_HW_CACHE_L1D|(PERF_COUNT_HW_CACHE_RESULT_MISS<<16),PERF_COUNT_HW_CACHE_DTLB|(PERF_COUNT_HW_CACHE_RESULT_MISS<<16)};
+void pmu_close(void){for(int i=0;i<count;i++){if(fds[i]>=0)close(fds[i]);fds[i]=-1;}count=0;}
+int pmu_open(int mode){
+ int masks[]={15,3,13};if(mode<0||mode>2)return -EINVAL;count=0;
+ for(int event=0;event<4;event++){
+  if(!(masks[mode]&(1<<event)))continue;
+  struct perf_event_attr a={0};a.size=sizeof(a);a.type=types[event];a.config=configs[event];a.disabled=count==0;a.exclude_kernel=1;a.exclude_hv=1;
+  a.read_format=PERF_FORMAT_GROUP|PERF_FORMAT_TOTAL_TIME_ENABLED|PERF_FORMAT_TOTAL_TIME_RUNNING|PERF_FORMAT_ID;
+  int fd=syscall(__NR_perf_event_open,&a,0,-1,count?fds[0]:-1,0);
+  if(fd<0){int e=errno;pmu_close();return -e;}
+  fds[count]=fd;indices[count]=event;
+  if(ioctl(fd,PERF_EVENT_IOC_ID,&ids[count])){int e=errno;count++;pmu_close();return -e;}count++;
+ }
+ if(ioctl(fds[0],PERF_EVENT_IOC_ENABLE,PERF_IOC_FLAG_GROUP)){int e=errno;pmu_close();return -e;}
+ return 0;
+}
+int pmu_read(uint64_t out[6]){
+ uint64_t raw[11]={0};ssize_t n=read(fds[0],raw,sizeof(raw));if(n<0)return -errno;
+ if(raw[0]!=(uint64_t)count||n!=(ssize_t)((3+2*count)*8))return -EIO;
+ for(int i=0;i<6;i++)out[i]=0;out[0]=raw[1];out[1]=raw[2];
+ for(int j=0;j<count;j++){
+  int found=0;for(int i=0;i<count;i++)if(raw[4+2*j]==ids[i]){out[2+indices[i]]=raw[3+2*j];found=1;break;}
+  if(!found)return -EIO;
+ }
+ return 0;
+}
+#ifdef PROBE
+static volatile uint64_t sink;
+int main(void){printf("[");for(int mode=0;mode<3;mode++){
+ int result=pmu_open(mode);printf("%s{\"mode\":%d,\"open\":%d",mode?",":"",mode,result);
+ if(result==0){uint64_t a[6],b[6];if(pmu_read(a))abort();volatile uint64_t data[512];for(int i=0;i<512;i++)data[i]=i;
+ uint64_t v=0;for(int i=0;i<100000;i++)v+=data[(i*17)%512];sink=v;if(pmu_read(b))abort();
+ printf(",\"delta\":[");for(int i=0;i<6;i++)printf("%s%llu",i?",":"",(unsigned long long)(b[i]-a[i]));printf("]");pmu_close();}printf("}");}puts("]");}
+#endif
